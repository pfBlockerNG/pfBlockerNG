#!/bin/sh
# Install Grok bus hooks + rules into $HOME/.grok so they load even when the
# session cwd is a stale or detached worktree that does not contain them.
# Run from a checkout that has .grok/hooks/ and .grok/rules/bus.md.
set -eu

here=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
hooks_src="${here}/hooks"
rules_src="${here}/rules"
dest_hooks="${HOME}/.grok/hooks"
dest_rules="${HOME}/.grok/rules"

[ -f "${hooks_src}/grok-bus-pretool" ] || {
	printf '%s\n' "install-home: missing ${hooks_src}/grok-bus-pretool" >&2
	exit 2
}
[ -f "${rules_src}/bus.md" ] || {
	printf '%s\n' "install-home: missing ${rules_src}/bus.md" >&2
	exit 2
}

mkdir -p "${dest_hooks}" "${dest_rules}"
cp "${hooks_src}/grok-bus-pretool" "${dest_hooks}/grok-bus-pretool"
cp "${hooks_src}/grok-bus-stop" "${dest_hooks}/grok-bus-stop"
cp "${rules_src}/bus.md" "${dest_rules}/bus.md"
chmod +x "${dest_hooks}/grok-bus-pretool" "${dest_hooks}/grok-bus-stop"

# Home JSON uses absolute paths — project ${GROK_WORKSPACE_ROOT} is the stale-tree hole.
cat > "${dest_hooks}/bus.json" <<EOF
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${dest_hooks}/grok-bus-pretool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${dest_hooks}/grok-bus-stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
EOF

printf '%s\n' "installed ${dest_rules}/bus.md"
printf '%s\n' "installed ${dest_hooks}/bus.json grok-bus-pretool grok-bus-stop"
