#!/bin/sh
# Stop gate: do not end a grok-dev/grok-smoke turn while the smoke-1 bus is
# mis-armed, the monitor is missing, or unread mail remains.
# Owner off-switch: $HOME/.grok/pfb-msg-off (create only when the owner said stop).
# Fail-open on ssh/python/parse failure — never strand a turn because smoke is down.
set -u

OFF="${HOME}/.grok/pfb-msg-off"
[ -f "${OFF}" ] && exit 0

payload=$(cat || true)
[ -n "${payload}" ] || exit 0

# Genuine turn ends only. Session-end / cancel / error: observe, do not block.
# Last payload for diagnosis. Do not treat this as a bus message.
printf '%s\n' "${payload}" > "${HOME}/.grok/bus-stop-last.json" 2>/dev/null || true

reason=$(printf '%s\n' "${payload}" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("skip")
    sys.exit(0)
print(d.get("reason") or "end_turn")
' 2>/dev/null) || reason="skip"
[ "${reason}" = "end_turn" ] || exit 0

stop_active=$(printf '%s\n' "${payload}" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
except Exception:
    print("0")
    sys.exit(0)
print("1" if d.get("stopHookActive") else "0")
' 2>/dev/null) || stop_active=0

eval "$(printf '%s\n' "${payload}" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("has_monitor=0; has_shell_serve=0; shell_id=")
    sys.exit(0)
has_monitor = 0
has_shell = 0
shell_id = ""
for t in d.get("backgroundTasks") or []:
    if not isinstance(t, dict):
        continue
    typ = str(t.get("type") or "")
    blob = " ".join(str(t.get(k) or "") for k in ("type", "command", "description"))
    # Monitor description is the human label (often "grok-dev bus"), not the argv.
    if typ == "monitor" and ("pfb-msg" in blob or "grok-dev bus" in blob):
        has_monitor = 1
    elif typ == "shell" and "pfb-msg" in blob and "serve" in blob:
        has_shell = 1
        shell_id = str(t.get("id") or "")
print("has_monitor=%d; has_shell_serve=%d; shell_id=%s" % (
    has_monitor, has_shell, json.dumps(shell_id)))
' 2>/dev/null)" || { has_monitor=0; has_shell_serve=0; shell_id=""; }

reasons=""

if [ "${has_shell_serve:-0}" = "1" ]; then
	reasons="${reasons} pfb-msg serve is running as background bash (id=${shell_id}). Kill it and arm the Grok monitor tool with persistent:true -- bash only notifies on exit and serve never exits on a message."
fi

# One grok-dev inbox. If smoke already has a watcher, do not make every
# other Grok TUI on this box arm a second consumer (they steal mail).
if [ "${has_monitor:-0}" != "1" ]; then
	n_watch=$(ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=accept-new \
		smoke 'ps -ef | awk "/[p]fb-msg/ && /grok-dev/ && !/awk/ { n++ } END { print n+0 }"' \
		2>/dev/null) || n_watch=0
	[ "${n_watch:-0}" -ge 1 ] && has_monitor=1
fi

if [ "${has_monitor:-0}" != "1" ]; then
	reasons="${reasons} No persistent pfb-msg serve monitor is running. Arm it now: monitor(command=\"ssh -o BatchMode=yes smoke 'export PFB_AGENT=grok-dev; exec /srv/Smoke/bin/pfb-msg serve grok-dev'\", persistent=true). Owner standing order: keep comms on unless they said stop (~/.grok/pfb-msg-off)."
fi

# Peek only when smoke answers. ConnectTimeout keeps the gate off the 600s Stop budget.
unread=$(ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=accept-new \
	smoke 'export PFB_AGENT=grok-dev; exec /srv/Smoke/bin/pfb-msg peek grok-dev' 2>/dev/null) || unread=""
case "${unread}" in
""|"("*no\ unread*)
	unread=""
	;;
esac
if [ -n "${unread}" ]; then
	reasons="${reasons} Unread pfb-msg — read and act before going idle: ${unread}"
fi

# Persistent monitors are not always listed in backgroundTasks (probed: Stop
# looped after a live monitor printed its watching line). After one block this
# turn, do not re-block on missing-monitor alone. Unread and bash-serve still block.
if [ "${stop_active}" = "1" ] && [ "${has_shell_serve:-0}" != "1" ] && [ -z "${unread}" ]; then
	exit 0
fi

[ -n "${reasons}" ] || exit 0

# One JSON object. python3 for safe quoting; fail-open if it cannot emit.
REASON_TEXT=$(printf '%s\n' "${reasons}" | sed 's/^ //')
export REASON_TEXT
python3 -c '
import json, os, sys
reason = os.environ.get("REASON_TEXT", "").strip()
if not reason:
    sys.exit(0)
print(json.dumps({"decision": "block", "reason": reason}))
' 2>/dev/null || printf '%s\n' '{"decision":"block","reason":"pfb-msg bus gate: re-arm monitor persistent:true and peek unread before stopping."}'
exit 0
