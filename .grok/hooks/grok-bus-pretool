#!/bin/sh
# PreToolUse: deny pfb-msg serve via run_terminal_command / Bash.
# That tool notifies only on process exit; serve never exits on a message.
# Session-length bus is the Grok monitor tool with persistent:true.
#
# Fail-open: empty/garbled stdin, or no match, exits 0 with no stdout.
# Raw-text scan, no JSON parser (same contract as scripts/claude-bash-guard.sh).
set -u

payload=$(cat || true)
[ -n "${payload}" ] || exit 0

# Monitor tool is the allowed path — never deny it.
case "${payload}" in
*"\"toolName\":\"monitor\""*|*"\"toolName\": \"monitor\""*|*"\"toolName\":\"Monitor\""*)
	exit 0
	;;
esac

# Collapse quotes/whitespace so `pfb-msg  serve` and `pfb-msg' 'serve` still match.
# After deleting JSON quotes, a bare command is `command:pfb-msg serve` (no
# space before the binary) — match the phrase anywhere, not only at a token
# boundary.
norm=$(printf '%s\n' "${payload}" | tr -d "'\"\\\\" | tr '\t\n' '  ')
norm=$(printf '%s\n' "${norm}" | sed 's/  */ /g')

case "${norm}" in
*"pfb-msg serve"*)
	printf '%s\n' '{"decision":"deny","reason":"pfb-msg serve via run_terminal_command is deaf: that tool notifies only on process exit, and serve never exits on a message (probed 2026-08-27: 8h silent, unread piled). Arm the Grok monitor tool with persistent:true. One-shot form is pfb-msg watch. See .grok/rules/bus.md and ~/.grok/rules/bus.md."}'
	;;
esac
exit 0
