#!/bin/sh
# prepare-commit-msg: agent worktree guard, then credit the human owner as a
# Co-Authored-By trailer.
#
# In agent / managed-remote environments the *committer* is the agent (e.g.
# Claude) and GitHub attributes the commit — and the contribution credit it
# shows — to that committer. The human is recorded only as the git author,
# which GitHub does NOT surface as a contributor on the commit. This hook
# appends a Co-Authored-By trailer for the human so they are credited, while
# the agent stays the committer/signer (e.g. for a Verified signature).
#
# The coauthor is resolved without hardcoding an identity. Provider-specific
# coauthor.<provider>.* keys win. The legacy coauthor.* key remains the Claude
# and human-session fallback, but is deliberately ignored in Codex sessions so
# a clone configured to credit Claude cannot misattribute Codex work. Then:
#   1. the matching provider-specific / legacy git config
#   2. $CLAUDE_CODE_USER_EMAIL (managed-remote owner)
#   3. the commit author, when it differs from the committer
# The display name falls back to a prior commit by that email, then the email's
# local-part. The hook is a NO-OP when the human is already the committer (a
# developer signing their own commits), when no human can be resolved, or when
# that co-author is already present — so it is safe in every environment.
#
# Enable: git config core.hooksPath .githooks

set -u

# Agent worktree guard (issue #1262): abort a Claude Code or Codex commit in the
# primary checkout (--git-dir == --git-common-dir; agents commit only in linked
# worktrees). Lives in THIS hook because it still runs when verification is
# skipped. Exempt: managed-remote sessions (CLAUDE_CODE_USER_EMAIL set) or an
# explicit `git config pfblockerng.allowprimarycommit true` (agent-dedicated).
agent_runtime=0
[ "${CLAUDECODE:-}" = "1" ] && agent_runtime=1
[ -n "${CODEX_THREAD_ID:-}" ] && agent_runtime=1
if [ "$agent_runtime" = "1" ] && [ -z "${CLAUDE_CODE_USER_EMAIL:-}" ] &&
	[ "$(git config --bool --get pfblockerng.allowprimarycommit 2>/dev/null)" != "true" ]; then
	unset CDPATH # a CDPATH hit makes cd echo the dir, corrupting $(cd ... && pwd -P)
	git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
	common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
	if [ "$git_dir" = "$common_dir" ]; then
		echo "prepare-commit-msg: agent commit in the primary checkout blocked — agents commit only in a linked worktree (issue #1262)." >&2
		echo "If this checkout is dedicated to the agent: git config pfblockerng.allowprimarycommit true" >&2
		exit 1
	fi
fi
unset agent_runtime

msg_file=$1
msg_type=${2:-}

# Only touch ordinary commits — leave merge/squash messages alone.
case "$msg_type" in
	merge|squash) exit 0 ;;
esac

ident_email() {
	# Extract the <email> from a "Name <email> ts tz" ident line.
	printf '%s\n' "$1" | sed -n 's/.*<\(.*\)>.*/\1/p'
}

committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null) || exit 0
committer_email=$(ident_email "$committer_ident")

# Resolve the coauthor's email, most specific source first. CODEX_THREAD_ID
# takes precedence if an unusual nested environment exposes both markers.
provider=''
[ "${CLAUDECODE:-}" = "1" ] && provider=claude
[ -n "${CODEX_THREAD_ID:-}" ] && provider=codex
case "$provider" in
	codex) email=$(git config --get coauthor.codex.email 2>/dev/null || true) ;;
	claude)
		email=$(git config --get coauthor.claude.email 2>/dev/null || true)
		[ -n "$email" ] || email=$(git config --get coauthor.email 2>/dev/null || true)
		;;
	*) email=$(git config --get coauthor.email 2>/dev/null || true) ;;
esac
[ -n "$email" ] || email=${CLAUDE_CODE_USER_EMAIL:-}
if [ -z "$email" ]; then
	author_email=$(ident_email "$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)")
	[ -n "$author_email" ] && [ "$author_email" != "$committer_email" ] && email=$author_email
fi

# Nothing to credit, or the human IS the committer (already credited) → no-op.
[ -n "$email" ] || exit 0
[ "$email" != "$committer_email" ] || exit 0

# Already credited in this message? → no-op (case-insensitive, literal email).
if grep -i 'co-authored-by:' "$msg_file" 2>/dev/null | grep -qiF "<$email>"; then
	exit 0
fi

# Resolve a display name (cosmetic — GitHub matches the co-author by email).
case "$provider" in
	codex) name=$(git config --get coauthor.codex.name 2>/dev/null || true) ;;
	claude)
		name=$(git config --get coauthor.claude.name 2>/dev/null || true)
		[ -n "$name" ] || name=$(git config --get coauthor.name 2>/dev/null || true)
		;;
	*) name=$(git config --get coauthor.name 2>/dev/null || true) ;;
esac
[ -n "$name" ] || name=$(git log -1 --author="$email" --format='%an' 2>/dev/null || true)
[ -n "$name" ] || name=${email%@*}

# Append as a real trailer (interpret-trailers handles the blank-line block);
# fall back to a plain append if interpret-trailers is unavailable.
git interpret-trailers --in-place \
	--trailer "Co-Authored-By: $name <$email>" "$msg_file" 2>/dev/null \
	|| printf '\nCo-Authored-By: %s <%s>\n' "$name" "$email" >>"$msg_file"
