#!/bin/sh
# Enforces the release tag scheme before any push reaches the remote, and — for
# agent pushes — force-with-lease semantics by EFFECT (issue #1307).
# Single source of truth for the tag scheme: scripts/release-version.sh.
#
# Rules:
#   - every versioned tag is annotated and carries exactly one explicit channel trailer
#   - its commit must be reachable from the exact release/X.Y line derived by the parser
#   - malformed metadata, an unknown channel, or an unreachable release line -> rejected
#   - agent (Claude, Codex, Copilot, Grok, or OMP marker set) branch push
#     rewriting remote history -> allowed only when the advertised remote oid
#     equals the local
#     remote-tracking ref, i.e. the history being overwritten was fetched
#     (--force-with-lease's check, applied to the push's effect regardless of
#     how it was spelled)
#
# Enable: git config core.hooksPath .githooks

z40="0000000000000000000000000000000000000000"
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="."
CLASSIFY="${ROOT}/scripts/release-version.sh"
[ -f "$CLASSIFY" ] || [ -z "${PFB_ROOT:-}" ] || CLASSIFY="${PFB_ROOT}/scripts/release-version.sh"

# Both loops below consume the per-ref update list, so capture stdin once.
updates=$(cat)

while IFS=' ' read -r local_ref local_sha remote_ref _remote_sha; do
    # Only inspect tag pushes
    case "$remote_ref" in refs/tags/*) ;; *) continue ;; esac

    # Skip tag deletions
    [ "$local_sha" = "$z40" ] && continue

    tag="${remote_ref#refs/tags/}"

    # Only enforce versioned tags (vX.Y.Z and vX.Y.Z.<suffix>)
    case "$tag" in v[0-9]*.[0-9]*.[0-9]*) ;; *) continue ;; esac

    if [ ! -f "$CLASSIFY" ]; then
        echo "error: ${CLASSIFY} not found — cannot validate the tag scheme" >&2
        exit 1
    fi

    tag_ref="refs/tags/${tag}"
    if [ "$local_ref" != "$tag_ref" ]; then
        echo "error: versioned tag '$tag' must be pushed from source ref '$tag_ref'" >&2
        exit 1
    fi
    ref_sha=$(git rev-parse --verify "$tag_ref" 2>/dev/null || true)
    if [ "$ref_sha" != "$local_sha" ]; then
        echo "error: tag '$tag' update does not match its local tag object" >&2
        exit 1
    fi
    type=$(git cat-file -t "$local_sha" 2>/dev/null || true)
    if [ "$type" != "tag" ]; then
        if [ -z "$type" ]; then
            echo "error: '$tag' does not point to a commit reachable from an exact release/X.Y line" >&2
            exit 1
        fi
        echo "error: tag '$tag' must be an annotated tag" >&2
        exit 1
    fi

    trailers=$(git for-each-ref --format='%(trailers:unfold)' "$tag_ref")
    channel_count=$(printf '%s\n' "$trailers" | grep -Eic '^pfBlockerNG-Release-Channel:' || true)
    if [ "$channel_count" -ne 1 ]; then
        echo "error: tag '$tag' must carry exactly one release-channel trailer" >&2
        exit 1
    fi
    channel_line=$(printf '%s\n' "$trailers" | grep -F 'pfBlockerNG-Release-Channel:' || true)
    case "$channel_line" in
        'pfBlockerNG-Release-Channel: stable') channel=stable ;;
        'pfBlockerNG-Release-Channel: testing') channel=testing ;;
        'pfBlockerNG-Release-Channel: edge') channel=edge ;;
        *) channel= ;;
    esac
    if [ -z "$channel" ]; then
        echo "error: tag '$tag' has an unknown release-channel trailer" >&2
        exit 1
    fi

    # Classify from the explicit trailer, never from a suffix or branch name.
    if ! err=$(sh "$CLASSIFY" "$tag" "$channel" 2>&1 >/dev/null); then
        echo "error: tag '$tag' is not valid for channel '$channel':" >&2
        printf '%s\n' "$err" | sed 's/^/       /' >&2
        exit 1
    fi

    release_line=$(sh "$CLASSIFY" "$tag" "$channel" | sed -n 's/^release_line=//p')
    commit=$(git rev-parse --verify "${local_sha}^{commit}" 2>/dev/null) || {
        echo "error: tag '$tag' does not resolve to a commit" >&2
        exit 1
    }
    if ! git merge-base --is-ancestor "$commit" "origin/$release_line" 2>/dev/null; then
        echo "error: '$tag' does not point to a commit reachable from 'origin/$release_line'" >&2
        echo "       Push the commit to the exact release line and wait for CI to pass before tagging." >&2
        exit 1
    fi
done <<PFB_TAG_UPDATES
$updates
PFB_TAG_UPDATES

# Agent lease-by-effect guard (issue #1307): deny an agent branch rewrite over
# remote history it never fetched (advertised remote oid != remote-tracking ref).
# Copilot CLI exports COPILOT_CLI=1 into every shell it spawns (probed on 1.0.78,
# 2026-08-06: inherited by nested shells and visible to git hooks), and the cloud
# agent sets COPILOT_AGENT_PROMPT. Grok CLI exports GROK_AGENT=1 and
# GROK_SESSION_ID (probed on 1.0.4, 2026-08-15: inherited by nested sh/bash).
# OMP reads OMP_CLI=1 from its user .env and mirrors it to PI_CLI=1. The same
# inherited-variable contract applies; no process tree is inspected.
copilot_session() {
	[ -n "${COPILOT_CLI:-}" ] || [ -n "${COPILOT_AGENT_PROMPT:-}" ]
}

grok_session() {
	[ -n "${GROK_SESSION_ID:-}" ] || [ -n "${GROK_AGENT:-}" ]
}

omp_session() {
	[ -n "${OMP_CLI:-}" ] || [ -n "${PI_CLI:-}" ]
}

agent_runtime=0
[ "${CLAUDECODE:-}" = "1" ] && agent_runtime=1
[ -n "${CODEX_THREAD_ID:-}" ] && agent_runtime=1
[ "$agent_runtime" = "1" ] || ! copilot_session || agent_runtime=1
[ "$agent_runtime" = "1" ] || ! grok_session || agent_runtime=1
[ "$agent_runtime" = "1" ] || ! omp_session || agent_runtime=1
remote_name="${1:-origin}"
if [ "$agent_runtime" = "1" ]; then
    while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha; do
        case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
        [ "$local_sha" = "$z40" ] && continue   # branch deletion
        [ "$remote_sha" = "$z40" ] && continue  # branch creation
        git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null && continue
        branch="${remote_ref#refs/heads/}"
        tracking=$(git rev-parse --verify "refs/remotes/${remote_name}/${branch}" 2>/dev/null) || tracking=""
        if [ "$remote_sha" != "$tracking" ]; then
            echo "error: agent push would rewrite unfetched history of '${branch}' (issue #1307)." >&2
            echo "       The remote moved past your remote-tracking ref: run 'git fetch ${remote_name}'," >&2
            echo "       rebase onto the new tip, then push with --force-with-lease." >&2
            exit 1
        fi
    done <<PFB_LEASE_UPDATES
$updates
PFB_LEASE_UPDATES

    configured_name=$(git config --get user.name 2>/dev/null) || configured_name=
    configured_email=$(git config --get user.email 2>/dev/null) || configured_email=
    configured_signing_key=$(git config --get user.signingkey 2>/dev/null) || configured_signing_key=
    configured_gpg_format=$(git config --get gpg.format 2>/dev/null) || configured_gpg_format=openpgp
    [ -n "$configured_gpg_format" ] || configured_gpg_format=openpgp
    configured_fingerprint=
    if [ -n "$configured_signing_key" ]; then
        case "$configured_gpg_format" in
            ssh)
                case "$configured_signing_key" in
                    key::*)
                        configured_key_record=$(printf '%s\n' "${configured_signing_key#key::}" |
                            ssh-keygen -lf - 2>/dev/null) || configured_key_record=
                        ;;
                    *)
                        configured_key_record=$(ssh-keygen -lf "$configured_signing_key" 2>/dev/null) ||
                            configured_key_record=
                        ;;
                esac
                case "$configured_key_record" in
                    *" "*)
                        configured_fingerprint=${configured_key_record#* }
                        configured_fingerprint=${configured_fingerprint%% *}
                        ;;
                esac
                ;;
            openpgp)
                configured_key_records=$(gpg --batch --with-colons --fingerprint \
                    --list-keys "$configured_signing_key" 2>/dev/null) || configured_key_records=
                configured_fingerprint=$(printf '%s\n' "$configured_key_records" |
                    awk -F: '$1 == "fpr" { print $10; exit }')
                ;;
        esac
    fi
fi

    check_outgoing_commit() {
        agent_commit=$1
        agent_message=$(git log -1 --format=%B "$agent_commit" 2>/dev/null) || return 1
        printf '%s\n' "$agent_message" | LC_ALL=C grep -Eiq '^[[:space:]]*Co-authored-by[[:space:]]*:' >/dev/null
        agent_coauthor_status=$?
        case "$agent_coauthor_status" in
            0)
                echo "Co-authored-by trailers are forbidden" >&2
                return 1
                ;;
            1) ;;
            *) return 1 ;;
        esac

        [ "$agent_runtime" = "1" ] || return 0

        if [ -z "$configured_name" ] || [ -z "$configured_email" ]; then
            echo "Agent commits must use the configured user identity" >&2
            return 1
        fi
        agent_author_name=$(git log -1 --format=%an "$agent_commit" 2>/dev/null) || return 1
        agent_author_email=$(git log -1 --format=%ae "$agent_commit" 2>/dev/null) || return 1
        agent_committer_name=$(git log -1 --format=%cn "$agent_commit" 2>/dev/null) || return 1
        agent_committer_email=$(git log -1 --format=%ce "$agent_commit" 2>/dev/null) || return 1
        if [ "$agent_author_name" != "$configured_name" ] ||
            [ "$agent_author_email" != "$configured_email" ] ||
            [ "$agent_committer_name" != "$configured_name" ] ||
            [ "$agent_committer_email" != "$configured_email" ]; then
            echo "Agent commits must use the configured user identity" >&2
            return 1
        fi

        if [ -z "$configured_fingerprint" ]; then
            echo "Agent commits must be signed by the configured user identity" >&2
            return 1
        fi
        agent_signature_status=$(git log -1 --format=%G? "$agent_commit" 2>/dev/null) || return 1
        agent_signer=$(git log -1 --format=%GS "$agent_commit" 2>/dev/null) || return 1
        agent_signature_fingerprint=$(git log -1 --format=%GF "$agent_commit" 2>/dev/null) || return 1
        agent_primary_fingerprint=$(git log -1 --format=%GP "$agent_commit" 2>/dev/null) || return 1

        agent_signer_ok=0
        case "$agent_signer" in
            "$configured_email"|*"<$configured_email>"*) agent_signer_ok=1 ;;
        esac

        agent_fingerprint_ok=0
        case "$configured_gpg_format" in
            ssh)
                if [ "$configured_fingerprint" = "$agent_signature_fingerprint" ] ||
                    [ "$configured_fingerprint" = "$agent_primary_fingerprint" ]; then
                    agent_fingerprint_ok=1
                fi
                ;;
            openpgp)
                if printf '%s\n%s\n' "$agent_signature_fingerprint" "$agent_primary_fingerprint" |
                    LC_ALL=C grep -Fixq "$configured_fingerprint" >/dev/null; then
                    agent_fingerprint_ok=1
                fi
                ;;
        esac

        if [ "$agent_signature_status" = "G" ] &&
            [ "$agent_signer_ok" = "1" ] &&
            [ "$agent_fingerprint_ok" = "1" ]; then
            return 0
        fi
        echo "Agent commits must be signed by the configured user identity" >&2
        return 1
    }

    while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha; do
        [ "$local_sha" = "$z40" ] && continue
        local_commit=$(git rev-parse --verify "${local_sha}^{commit}" 2>/dev/null) || continue
        remote_commit=
        if [ "$remote_sha" != "$z40" ]; then
            remote_commit=$(git rev-parse --verify "${remote_sha}^{commit}" 2>/dev/null) || remote_commit=
        fi
        if [ -n "$remote_commit" ]; then
            outgoing_commits=$(git rev-list "$local_commit" "^$remote_commit" --not --remotes="${remote_name}/*" 2>/dev/null) || exit 1
        else
            outgoing_commits=$(git rev-list "$local_commit" --not --remotes="${remote_name}/*" 2>/dev/null) || exit 1
        fi
        while IFS= read -r outgoing_commit; do
            [ -z "$outgoing_commit" ] && continue
            check_outgoing_commit "$outgoing_commit" || exit 1
        done <<PFB_AGENT_COMMITS
$outgoing_commits
PFB_AGENT_COMMITS
    done <<PFB_AGENT_UPDATES
$updates
PFB_AGENT_UPDATES
unset agent_runtime

# Root graph freshness (issue #3139): the tree being pushed must carry a
# graphify-out/graph.json byte-identical to its own seeded rebuild, so a push
# with a stale graph never reaches the remote. Graded last (the rebuild is the
# expensive gate) and once per push that publishes anything; a deletion-only
# push moves no tree. The checker refuses on its own: stale (1), no graph (2),
# and a missing Graphify (4) all abort with its message. A tree that ships no
# checker never adopted the invariant (release lines) and is not graded; on
# devel the checker's presence is pinned by tests/test_cross_agent_tooling.py.
graph_check="${ROOT}/scripts/agent/check-graph-fresh.sh"
if [ -f "$graph_check" ]; then
    while IFS=' ' read -r _local_ref local_sha _remote_ref _remote_sha; do
        [ -n "$local_sha" ] || continue
        [ "$local_sha" = "$z40" ] && continue
        sh "$graph_check" || exit 1
        break
    done <<PFB_GRAPH_UPDATES
$updates
PFB_GRAPH_UPDATES
fi

exit 0
