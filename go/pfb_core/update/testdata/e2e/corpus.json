  {
   "id": "both_first_run_then_unchanged_then_changed",
   "description": "Two IPv4 feeds in one Deny group, an IPv6 Deny group and a DNSBL group: the first manual Update builds every set and the DNSBL data; the same request again finds every feed unchanged (the mock answers 304 to the ETag it gave); a retry Update naming one IPv4 feed after its body changed rebuilds that group only.",
   "groups": [
    {"kind": "ipv4", "name": "E2EOneDeny", "action": "Deny_Both", "feeds": [{"header": "E2E1A", "serve": "e2e1_v4a"}, {"header": "E2E1B", "serve": "e2e1_v4b"}]},
    {"kind": "ipv6", "name": "E2EOneSix", "action": "Deny_Both", "feeds": [{"header": "E2E1S", "serve": "e2e1_v6"}]},
    {"kind": "dnsbl", "name": "E2EOneAds", "feeds": [{"header": "E2E1D", "serve": "e2e1_dns"}]}
   ],
   "serve": {
    "e2e1_v4a": {"text": "# E2E1A\n192.0.2.1\n192.0.2.2\n198.51.100.0/24\n", "etag": "\"a1\""},
    "e2e1_v4b": {"text": "203.0.113.7\n203.0.113.8\n192.0.2.2\n", "etag": "\"b1\""},
    "e2e1_v6": {"text": "2001:db8:1::1\n2001:db8:2::/48\n", "etag": "\"s1\""},
    "e2e1_dns": {"text": "uuid-e2e4038a01.com\nuuid-e2e4038a02.com\n0.0.0.0 uuid-e2e4038a03.com\n", "etag": "\"d1\""}
   },
   "steps": [
    {"request": {"trigger": "manual", "scope": "both", "force": "none"}},
    {"request": {"trigger": "manual", "scope": "both", "force": "none"}},
    {"serve": {"e2e1_v4a": {"text": "192.0.2.1\n192.0.2.9\n", "etag": "\"a2\""}},
     "request": {"trigger": "retry", "feeds": ["ipv4:E2E1A_v4"]}}
   ]
  },
  {
