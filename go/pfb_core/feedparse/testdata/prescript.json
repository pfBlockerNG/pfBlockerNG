{"schema": 1, "cases": [
  {"id": "success-replaces-the-parse-input", "description": "The script rewrites the staged copy: the transform ran, the staged copy is what gets parsed and .norm is untouched.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "tr a-z A-Z < \"$1\" > \"$1.t\" && mv \"$1.t\" \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "A.EXAMPLE.COM\nB.EXAMPLE.COM\n"}}},
  {"id": "arguments-are-the-staged-path-and-the-list-type", "description": "The script gets the staged path and the list type, nothing else.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "printf '%s\\n' \"$#\" \"$2\" > \"$1\"", "mode": "exec"}, "list_type": "dnsbl", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "2\ndnsbl\n"}}},
  {"id": "nonzero-exit-keeps-last-known-good", "description": "A failing script: its leftovers are discarded (the staged copy is removed) and the caller parses nothing new.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "echo partial > \"$1\"; exit 3", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "exit", "status": 3, "files": {"norm": "a.example.com\nb.example.com\n"}}},
  {"id": "empty-output-is-a-valid-transform", "description": "A script that empties the staged copy succeeded: an empty feed is parsed (the empty-feed rule, not the pre-script, decides what that means).", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "true > \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": ""}}},
  {"id": "script-deletes-its-input", "description": "A script that removes its staged input failed.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "rm -f \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "deleted", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n"}}},
  {"id": "timeout-kills-a-blocked-script", "description": "A script that never ends is killed and its staged copy removed.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "if [ -n \"$PFB_TEST_READY\" ]; then echo ready > \"$PFB_TEST_READY\"; fi\nread -r line < \"$PFB_TEST_BLOCK\"", "mode": "exec"}, "list_type": "_v4", "blocks": true, "expect": {"ok": false, "reason": "timeout", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n"}}},
  {"id": "script-name-with-spaces-and-metacharacters", "description": "The script is run as named, never through a shell that reads its name: spaces, quotes, ;, & and $( ) stay part of the file name.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "my script;$(echo pwned > \"$PFB_TEST_CANARY\")&'x\".sh", "body": "printf '%s\\n' \"${0##*/}\" \"$2\" > \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "my script;$(echo pwned > \"$PFB_TEST_CANARY\")&'x\".sh\n_v4\n"}}},
  {"id": "script-name-leading-dash", "description": "A script whose name starts with a dash is still the program, not an option.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "-x.sh", "body": "printf '%s\\n' \"${0##*/}\" > \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "-x.sh\n"}}},
  {"id": "script-not-executable", "description": "A script without its execute bit cannot be started: status 126.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "true", "mode": "noexec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "exit", "status": 126, "files": {"norm": "a.example.com\nb.example.com\n"}}},
  {"id": "script-missing", "description": "A script that is not there cannot be started: status 127.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "true", "mode": "absent"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "exit", "status": 127, "files": {"norm": "a.example.com\nb.example.com\n"}}},
  {"id": "norm-missing-cannot-stage", "description": "No normalized feed to stage: the script never runs and the caller keeps its last known-good list.", "setup": {}, "script": {"name": "transform.sh", "body": "echo ran > \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "stage", "status": 0, "files": {}}},
  {"id": "stale-staged-copy-is-overwritten", "description": "A staged copy left by an earlier run is replaced by the fresh normalized feed before the script runs.", "setup": {"norm": "a.example.com\nb.example.com\n", "staged": "STALE\n"}, "script": {"name": "transform.sh", "body": "true", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "a.example.com\nb.example.com\n"}}},
  {"id": "hostile-bytes-pass-through-the-copy", "description": "The staged copy is a byte copy of the normalized feed, whatever the bytes.", "setup": {"norm_hex": "610062ff0d0a0a"}, "script": {"name": "transform.sh", "body": "true", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm_hex": "610062ff0d0a0a", "staged_hex": "610062ff0d0a0a"}}},
  {"id": "script-without-shebang", "description": "A script with its execute bit and no #! line still runs, as a shell script: the old path goes through execvp, which falls back to /bin/sh when the file is no executable format.", "setup": {"norm": "a.example.com\nb.example.com\n"}, "script": {"name": "transform.sh", "body": "printf '%s\\n' \"${0##*/}\" \"$2\" > \"$1\"", "mode": "exec", "shebang": false}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\nb.example.com\n", "staged": "transform.sh\n_v4\n"}}},
  {"id": "stale-staged-copy-longer-than-the-feed", "description": "A staged copy left by an earlier run and longer than the fresh feed is truncated, not overwritten in place: no tail of the stale copy survives.", "setup": {"norm": "a.example.com\n", "staged": "STALE-STALE-STALE-STALE-STALE-STALE\n"}, "script": {"name": "transform.sh", "body": "true", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": true, "reason": "", "status": 0, "files": {"norm": "a.example.com\n", "staged": "a.example.com\n"}}},
  {"id": "norm-missing-removes-a-stale-staged-copy", "description": "No normalized feed to stage and a staged copy left by an earlier run: the stale copy is removed, so the caller cannot parse it as this pass's feed.", "setup": {"staged": "STALE\n"}, "script": {"name": "transform.sh", "body": "echo ran > \"$1\"", "mode": "exec"}, "list_type": "_v4", "blocks": false, "expect": {"ok": false, "reason": "stage", "status": 0, "files": {}}}
]}
