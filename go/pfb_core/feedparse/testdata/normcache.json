{"schema": 1, "cases": [
  {"id": "fresh-sidecar-hit-is-unchanged", "description": "A sidecar naming the current .orig and a .norm beside it: the cached .norm is returned untouched (it is not rebuilt, so a stale marker in it survives) and changed is false.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": "d615a18420594aec571c642da94065c4"}, "expect": {"path": "norm", "changed": false, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "regeneration-identical-is-unchanged", "description": "A stale sidecar but the regenerated .norm is byte-identical to the one on disk: the baseline existed, so changed is false, and the sidecar now names the current .orig.", "setup": {"orig": "a.example.com\r\nb.example.com\r\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "ca099c9214b7ff5220582f114161eb1f"}, "expect": {"path": "norm", "changed": false, "normalized": true, "files": {"orig": "a.example.com\r\nb.example.com\r\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "fb19b52d1fcc12f8fce72b039acc41e8"}}},
  {"id": "new-bytes-are-changed", "description": "The .orig changed since the sidecar was written and the .norm differs after regeneration: changed is true, the .norm is replaced and the sidecar updated.", "setup": {"orig": "a.example.com\nb.example.com\nc.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\nc.example.com\n", "norm": "a.example.com\nb.example.com\nc.example.com\n", "xxhash128": "733f0ff0d1ddd0d4a6fa31c7a85eee08"}}},
  {"id": "missing-sidecar-is-changed", "description": "No sidecar is no baseline: even a byte-identical regeneration reports changed (fail-safe, so Force defeats the reuse skip).", "setup": {"orig": "a.example.com\r\nb.example.com\r\n", "norm": "a.example.com\nb.example.com\n"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\r\nb.example.com\r\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "fb19b52d1fcc12f8fce72b039acc41e8"}}},
  {"id": "missing-norm-is-changed", "description": "A fresh sidecar without its .norm: the .norm is rebuilt and, with nothing to compare, changed is true.", "setup": {"orig": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "corrupt-sidecar-is-changed", "description": "A sidecar that is not a digest is no baseline: changed is true and the sidecar is rewritten.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "not a digest\n"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "short-sidecar-is-changed", "description": "A 31-character digest is corrupt.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "uppercase-sidecar-is-changed", "description": "A digest is lower-case hex: an upper-case one is corrupt.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "D615A18420594AEC571C642DA94065C4"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "padded-sidecar-is-read", "description": "Whitespace around the digest is trimmed, as pfb_hash_read() does: a fresh sidecar still hits.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": " \td615a18420594aec571c642da94065c4\r\n\u0000\u000b"}, "expect": {"path": "norm", "changed": false, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": " \td615a18420594aec571c642da94065c4\r\n\u0000\u000b"}}},
  {"id": "legacy-md5-sidecar-is-no-baseline", "description": "A legacy md5 sidecar matching the .orig is no baseline for the normalize cache: the .norm is rebuilt, changed is true, the xxh128 sidecar is written and the md5 one is left.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "md5": "656857e20485ca265627f808633dbb65"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4", "md5": "656857e20485ca265627f808633dbb65"}}},
  {"id": "corrupt-xxh-never-falls-back-to-md5", "description": "A corrupt xxh128 sidecar next to a valid md5 one: the md5 is not consulted, changed is true.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "zz", "md5": "656857e20485ca265627f808633dbb65"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4", "md5": "656857e20485ca265627f808633dbb65"}}},
  {"id": "xxh-wins-over-md5", "description": "A valid xxh128 sidecar next to a garbage md5 one: the xxh128 decides and hits.", "setup": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": "d615a18420594aec571c642da94065c4", "md5": "garbage"}, "expect": {"path": "norm", "changed": false, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\n", "norm": "CACHED-NORM-NOT-REBUILT\n", "xxhash128": "d615a18420594aec571c642da94065c4", "md5": "garbage"}}},
  {"id": "missing-orig-parses-the-raw-path", "description": "No .orig: the caller is handed the .orig path, changed is true and nothing is created.", "setup": {"norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}, "expect": {"path": "orig", "changed": true, "normalized": false, "files": {"norm": "a.example.com\nb.example.com\n", "xxhash128": "d615a18420594aec571c642da94065c4"}}},
  {"id": "trailing-newline-and-controls", "description": "The .norm ends in a newline, loses its controls and trailing blanks (sed pass), and is written beside the .orig.", "setup": {"orig": "a.example.com \t\r\nb.example.com\u0007\nlast.example.com"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com \t\r\nb.example.com\u0007\nlast.example.com", "norm": "a.example.com\nb.example.com\nlast.example.com\n", "xxhash128": "be4db5b5ca6a977044a27bc437853edf"}}},
  {"id": "empty-orig", "description": "A zero-byte .orig normalizes to a zero-byte .norm (no newline is invented) and is cached.", "setup": {"orig": ""}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "", "norm": "", "xxhash128": "99aa06d3014798d86001c324468d497f"}}},
  {"id": "orig-only", "description": "The first pass over a downloaded .orig: no .norm, no sidecar; both are created and changed is true.", "setup": {"orig": "a.example.com\nb.example.com\nc.example.com\n"}, "expect": {"path": "norm", "changed": true, "normalized": true, "files": {"orig": "a.example.com\nb.example.com\nc.example.com\n", "norm": "a.example.com\nb.example.com\nc.example.com\n", "xxhash128": "733f0ff0d1ddd0d4a6fa31c7a85eee08"}}}
]}
