includes:
    - phpstan-baseline.neon

rules:
    # Bans empty() on statically-string-typed operands (empty('0') is TRUE —
    # issue #1787); the honest predicates are pfb_is_empty()/pfb_is_blank().
    - PfBlockerNG\PHPStan\NoEmptyOnStringRule

parameters:
    paths:
        - src
    # Climbing incrementally above level 0 (roadmap: issue #1144; origin #88):
    # each level statically catches more of the class the live Tier-A/UI run
    # catches at runtime (undefined variables/constants, bad arg counts,
    # return shapes). The phpstan-baseline.neon entries are the pre-existing
    # legacy debt at the current level — an acknowledged blind-spot list to
    # BURN DOWN, not grow. Next: burn down the level-2 baseline, then level 3.
    # No memory limit is configurable here (probed: 'Unexpected item') — run
    # via `composer phpstan`, which carries the required --memory-limit=2G.
    level: 2
    # Pulled forward from level 5 (issue #1144): checkFunctionArgumentTypes is a
    # plain parameter, not level-gated rule registration — probed clean at level
    # 2 (+24 argument.type, zero collateral noise) vs. jumping the whole level.
    checkFunctionArgumentTypes: true
    checkArgumentsPassedByReference: true
    fileExtensions:
        - php
        - inc
    # pfSense runtime functions and globals declared in stubs/ — scan so
    # PHPStan knows the symbols exist without analysing the stubs themselves.
    scanDirectories:
        - stubs/pfsense
    # Issue #2671: workers follow the JOB count, never the core count --
    # jobs = ceil(files / jobSize), workers = min(floor(jobs / 2), cores, 8). The
    # default jobSize of 20 makes 2 jobs out of 34 files and ONE worker out of 2
    # jobs, so the whole tree accumulates in a single allocator and the run needs
    # 576M; two or more workers need 448M, the floor pfblockerng.inc sets alone.
    # A warm result cache schedules only the files needing reanalysis, so a repeat
    # local run reports fewer jobs and may show one worker again. CI starts cold,
    # and the cold run is what this value is set for.
    parallel:
        jobSize: 10
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # pfSense runtime include files don't exist outside the appliance.
        - '#is not a file or it does not exist#'
