{
  // markdownlint-cli2 runner config (globs + ignores). Rule set lives in
  // `.markdownlint.jsonc`. Run from the repo root: `npx markdownlint-cli2`
  // (add `--fix` to auto-fix). Lints every tracked Markdown file, including
  // .ADRs/ and the repo's own .claude/skills/ + .agents/skills/; skips
  // dependency/virtualenv trees and the VENDORED plugin skill trees listed
  // below.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules/**",
    ".venv",
    "**/.venv/**",
    "vendor",
    "**/vendor/**",
    // Verbatim conversation transcript (a historical record, not maintained
    // documentation): its repeated "User"/"Assistant" headings and multiple
    // H1s are inherent to the format, so it is not linted.
    "**/TRANSCRIPT.md",
    // Vendored loose skills remain available when their upstream plugins do
    // not ship them: not ours to lint — fixing them here would drift upstream.
    // .agents/skills/<name> is the canonical path;
    // .claude/skills/<name> is a symlink onto it, but the glob walker
    // FOLLOWS symlinked directories (confirmed empirically), so both paths
    // need an entry or the same files get linted twice, once unignored.
    ".agents/skills/{batch-grill-me,cavecrew,caveman,caveman-commit,caveman-compress,caveman-help,caveman-review,caveman-stats,claude-handoff,design-an-interface,edit-article,git-guardrails-claude-code,loop-me,migrate-to-shoehorn,obsidian-vault,qa,request-refactor-plan,scaffold-exercises,setup-pre-commit,setup-ts-deep-modules,ubiquitous-language,writing-beats,writing-fragments,writing-shape}/**",
    ".claude/skills/{batch-grill-me,cavecrew,caveman,caveman-commit,caveman-compress,caveman-help,caveman-review,caveman-stats,claude-handoff,design-an-interface,edit-article,git-guardrails-claude-code,loop-me,migrate-to-shoehorn,obsidian-vault,qa,request-refactor-plan,scaffold-exercises,setup-pre-commit,setup-ts-deep-modules,ubiquitous-language,writing-beats,writing-fragments,writing-shape}/**",
    // Vendored upstream plugin tree (Codex local marketplace source).
    "plugins/**"
  ]
}
