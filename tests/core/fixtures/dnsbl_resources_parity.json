    {
      "id": "rows-json-decode-refuses",
      "description": "A staged line that is not UTF-8, or holds a lone UTF-16 surrogate escape: json_decode() fails, so both writers skip it, and Core counts it. A surrogate pair is one character to both. Today's widget counts every line.",
      "feeds": [
        {
          "header": "Utf",
          "group": "G",
          "log": "1",
          "staged": [
            "[\"d\", \"ok.example\"]",
            {
              "b64": "WyJkIiwiYmFk/3V0ZjguZXhhbXBsZSJd"
            },
            "[\"d\",\"\\ud800lone.example\"]",
            "[\"d\",\"\\ud83d\\ude00pair.example\"]"
          ]
        }
      ],
      "invalid": {
        "Utf": 2
      },
      "expect": {
        "feeds": [
          {
            "feed": "Utf",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "ok.example",
              "😀pair.example"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 2
          }
        ]
      },
      "old_expect": {
        "feeds": [
          {
            "feed": "Utf",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "ok.example",
              "😀pair.example"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 4
          }
        ]
      }
    },
