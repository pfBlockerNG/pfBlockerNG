      ],
      "expect": {
        "feeds": [
          {
            "feed": "Dups",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "/r+/",
              "a.example",
              "b..bad"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 3
          }
        ]
      },
      "old_expect": {
        "feeds": [
          {
            "feed": "Dups",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "a.example",
              "a.example",
              "/r+/",
              "/r+/",
              "b..bad",
              "b..bad"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 6
          }
        ]
      }
    },
