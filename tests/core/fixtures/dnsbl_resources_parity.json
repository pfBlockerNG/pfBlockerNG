      "feeds": [
        {
          "header": "Dups",
          "group": "G",
          "log": "1",
          "staged": [
            "[\"d\", \"a.example\"]",
            "[\"d\", \"a.example\"]",
            "[\"a\", \"/r+/\"]",
            "[\"a\", \"/r+/\"]",
            "[\"d\", \"b..bad\"]",
            "[\"d\", \"b..bad\"]"
          ]
