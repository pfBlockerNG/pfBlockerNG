    {
      "id": "rows-the-store-cannot-hold",
      "description": "Departure (plan-4036 section 2.4): a row holding a NUL or another control character, or starting with '#', cannot be a member. Core leaves it out and counts it, where today the .raw carries it to the build, which rejects or ignores it (the decision is the same; the reject tally and the group count differ).",
      "feeds": [
        {
          "header": "Odd",
          "group": "G",
          "log": "1",
          "staged": [
            "[\"d\", \"ok.example\"]",
            "[\"d\", \"nul\\u0000.example\"]",
            "[\"a\", \"||tab\\t.example^\"]",
            "[\"a\", \"##.banner\"]",
            "[\"d\", \"del.example\"]"
          ]
        }
      ],
      "dropped": {
        "dnsbl/feed-Odd": 4
      },
      "expect": {
        "feeds": [
          {
            "feed": "Odd",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "ok.example"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 1
          }
        ]
      },
      "old_expect": {
        "feeds": [
          {
            "feed": "Odd",
            "group": "G",
            "logFlag": "1",
            "provenance": "feed",
            "mode": "deny",
            "top1m": false,
            "rows": [
              "ok.example",
              "nul\u0000.example",
              "||tab\t.example^",
              "##.banner",
              "del.example"
            ]
          }
        ],
        "groups": [
          {
            "name": "G",
            "entries": 5
          }
        ]
      }
    },
