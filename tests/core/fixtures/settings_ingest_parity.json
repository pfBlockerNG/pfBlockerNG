    {"id":"defaults","description":"Nothing stored: suppression on with no CIDR limit, the DNSBL IP action off and strict, the feed-host filter on with an empty allowlist, no address of the box, no proxy.","config":{},"ingest":{},"php":{"supp":true,"floors":["Disabled","Disabled"],"dnsblIp":false,"lenient":false,"filter":true,"allow":[],"proxy":{"host":null,"port":null,"userpwd":null}}},
    {"id":"suppression-on","description":"ip suppression on.","config":{"ip":{"suppression":"on"}},"ingest":{},"php":{"supp":true}},
    {"id":"suppression-off","description":"ip suppression empty is an explicit Off.","config":{"ip":{"suppression":""}},"ingest":{"suppression":false},"php":{"supp":false}},
    {"id":"suppression-absent","description":"ip suppression not stored: the registered default, on.","config":{"ip":{"suppression_cidr":"Disabled"}},"ingest":{},"php":{"supp":true}},
    {"id":"cidr-disabled","description":"Both limits stored Disabled: 0.","config":{"ip":{"suppression_cidr":"Disabled","suppression_cidr_v6":"Disabled"}},"ingest":{},"php":{"floors":["Disabled","Disabled"]}},
    {"id":"cidr-v4-lowest","description":"IPv4 limit 1.","config":{"ip":{"suppression_cidr":"1","suppression_cidr_v6":"Disabled"}},"ingest":{"suppressionCidrV4":1},"php":{"floors":["1","Disabled"]}},
    {"id":"cidr-v4-highest-v6-highest","description":"IPv4 limit 17 and IPv6 limit 64: the highest the IP page offers.","config":{"ip":{"suppression_cidr":"17","suppression_cidr_v6":"64"}},"ingest":{"suppressionCidrV4":17,"suppressionCidrV6":64},"php":{"floors":["17","64"]}},
    {"id":"cidr-v6-lowest","description":"IPv6 limit 1.","config":{"ip":{"suppression_cidr":"Disabled","suppression_cidr_v6":"1"}},"ingest":{"suppressionCidrV6":1},"php":{"floors":["Disabled","1"]}},
    {"id":"cidr-fresh-install-seed","description":"The limits a fresh install is seeded with: 8 and 32.","config":{"ip":{"suppression_cidr":"8","suppression_cidr_v6":"32"}},"ingest":{"suppressionCidrV4":8,"suppressionCidrV6":32},"php":{"floors":["8","32"]}},
    {"id":"cidr-out-of-range","description":"Numbers beyond what the page offers (18, 65), only possible by editing config.xml: today's PHP applies them as typed; Core reads them as 0, as the group's own suppressionCidr reads a value out of its range.","config":{"ip":{"suppression_cidr":"18","suppression_cidr_v6":"65"}},"ingest":{},"php":{"floors":["18","65"]}},
    {"id":"cidr-garbage","description":"A limit that is no number is Disabled for PHP and 0 for Core.","config":{"ip":{"suppression_cidr":"abc","suppression_cidr_v6":""}},"ingest":{},"php":{"floors":["Disabled","Disabled"]}},
    {"id":"cidr-zero-and-negative","description":"0 and a negative number: PHP's floor never bites; Core reads 0.","config":{"ip":{"suppression_cidr":"0","suppression_cidr_v6":"-3"}},"ingest":{},"php":{"floors":["0","-3"]}},
    {"id":"cidr-not-a-plain-number","description":"Numeric strings that are not plain digits (8.5, 1e1): PHP applies them as typed; Core reads 0.","config":{"ip":{"suppression_cidr":"8.5","suppression_cidr_v6":"1e1"}},"ingest":{},"php":{"floors":["8.5","1e1"]}},
    {"id":"dnsbl-ip-disabled","description":"The DNSBL page's IP action Disabled.","config":{"dnsbl":{"action":"Disabled"}},"ingest":{},"php":{"dnsblIp":false}},
    {"id":"dnsbl-ip-deny-inbound","description":"Deny_Inbound: the parser tests only that the action is not Disabled.","config":{"dnsbl":{"action":"Deny_Inbound"}},"ingest":{"dnsblIp":true},"php":{"dnsblIp":true}},
    {"id":"dnsbl-ip-alias-native","description":"Alias_Native is another value that is not Disabled.","config":{"dnsbl":{"action":"Alias_Native"}},"ingest":{"dnsblIp":true},"php":{"dnsblIp":true}},
    {"id":"dnsbl-ip-invalid-action","description":"An action no group can have fails closed to Disabled in PHP.","config":{"dnsbl":{"action":"Drop_Everything"}},"ingest":{},"php":{"dnsblIp":false}},
    {"id":"lenient-on","description":"pfb_dnsbl_lenient on.","config":{"dnsbl":{"pfb_dnsbl_lenient":"on"}},"ingest":{"dnsblLenient":true},"php":{"lenient":true}},
    {"id":"lenient-off","description":"pfb_dnsbl_lenient empty.","config":{"dnsbl":{"pfb_dnsbl_lenient":""}},"ingest":{},"php":{"lenient":false}},
