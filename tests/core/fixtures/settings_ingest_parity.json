    {"id":"proxy-host-and-port","description":"System proxy URL (a host name) and port.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128"},"php":{"proxy":{"host":"proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-host-port-user-and-password","description":"Host, port, user and password, including punctuation: cURL carries the credentials in CURLOPT_PROXYUSERPWD.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"3128","proxyuser":"al:ice%","proxypass":"p:a@ss %"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128","proxyUser":"al:ice%","proxyPassword":"p:a@ss %"},"php":{"proxy":{"host":"proxy.example.com","port":"3128","userpwd":"al:ice%:p:a@ss %"}}},
    {"id":"proxy-user-without-password","description":"A user with no password is no authentication, as in PHP.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"3128","proxyuser":"alice"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128"},"php":{"proxy":{"host":"proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-password-without-user","description":"A password with no user is no authentication either.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"3128","proxypass":"secret"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128"},"php":{"proxy":{"host":"proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-host-without-port","description":"No port: cURL dials its default proxy port, 1080, and the URL says so.","config":{"system":{"proxyurl":"proxy.example.com"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":null,"userpwd":null}}},
    {"id":"proxy-port-zero-is-empty","description":"A port of 0 is empty() in PHP: no CURLOPT_PROXYPORT, so the default port.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"0"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":null,"userpwd":null}}},
    {"id":"proxy-ipv4-host","description":"An IPv4 address as the proxy.","config":{"system":{"proxyurl":"192.0.2.10","proxyport":"8080"}},"ingest":{"proxyUrl":"http://192.0.2.10:8080"},"php":{"proxy":{"host":"192.0.2.10","port":"8080","userpwd":null}}},
    {"id":"proxy-ipv6-host","description":"An IPv6 address as the proxy is bracketed in the URL.","config":{"system":{"proxyurl":"2001:db8::10","proxyport":"8080"}},"ingest":{"proxyUrl":"http://[2001:db8::10]:8080"},"php":{"proxy":{"host":"2001:db8::10","port":"8080","userpwd":null}}},
    {"id":"proxy-url-with-http-scheme","description":"A hand-edited http:// prefix is the scheme the URL gets anyway.","config":{"system":{"proxyurl":"http://proxy.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128"},"php":{"proxy":{"host":"http://proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-url-zero-is-empty","description":"A proxy URL of 0 is empty() in PHP: no proxy.","config":{"system":{"proxyurl":"0","proxyport":"3128"}},"ingest":{},"php":{"proxy":{"host":null,"port":null,"userpwd":null}}},
    {"id":"proxy-url-with-userinfo","description":"cURL accepts encoded proxy userinfo; the adapter moves its decoded values into the in-process secret fields.","config":{"system":{"proxyurl":"http://al%3Aice:p%40ss@proxy.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128","proxyUser":"al:ice","proxyPassword":"p@ss"},"php":{"proxy":{"host":"http://al%3Aice:p%40ss@proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-url-with-crlf","description":"A proxy URL with CR and LF is handed to cURL but cannot be expressed by Core.","config":{"system":{"proxyurl":"proxy.example.com\r\nX-Evil: 1","proxyport":"3128"}},"ingest":{"proxyUnusable":true},"php":{"proxy":{"host":"proxy.example.com\r\nX-Evil: 1","port":"3128","userpwd":null}}},
    {"id":"proxy-url-with-https-scheme","description":"A hand-edited https:// proxy scheme is accepted by cURL and retained for Core's TLS-to-proxy transport.","config":{"system":{"proxyurl":"https://proxy.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"https://proxy.example.com:3128"},"php":{"proxy":{"host":"https://proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-url-with-socks5-scheme","description":"cURL's SOCKS5 proxy scheme is retained for Go's standard-library SOCKS5 transport.","config":{"system":{"proxyurl":"socks5://proxy.example.com","proxyport":"1080"}},"ingest":{"proxyUrl":"socks5://proxy.example.com:1080"},"php":{"proxy":{"host":"socks5://proxy.example.com","port":"1080","userpwd":null}}},
    {"id":"proxy-url-with-socks4-scheme","description":"cURL accepts SOCKS4 but Go's built-in proxy transport cannot express it, so remote fetches must refuse.","config":{"system":{"proxyurl":"socks4://proxy.example.com","proxyport":"1080"}},"ingest":{"proxyUnusable":true},"php":{"proxy":{"host":"socks4://proxy.example.com","port":"1080","userpwd":null}}},
    {"id":"proxy-port-beyond-65535","description":"cURL accepts the configured port setting but a dial port above 65535 is inexpressible by Go and marks the proxy unusable.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"99999"}},"ingest":{"proxyUnusable":true},"php":{"proxy":{"host":"proxy.example.com","port":"99999","userpwd":null}}},
    {"id":"proxy-port-negative","description":"A negative port is refused by curl_setopt and makes the configured proxy unusable for Core.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"-5"}},"ingest":{"proxyUnusable":true},"php":{"proxy":{"host":"proxy.example.com","port":"-5","userpwd":null}}},
    {"id":"proxy-port-not-a-port","description":"A port that is no number reads as 0 to PHP: the default port, 1080, as a service name does.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"abc"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":"abc","userpwd":null}}},
    {"id":"proxy-host-with-underscore","description":"pfSense's is_fqdn() accepts an underscore in a label and cURL dials the host: the proxy is projected.","config":{"system":{"proxyurl":"my_proxy.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"http://my_proxy.example.com:3128"},"php":{"proxy":{"host":"my_proxy.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-host-with-underscores-in-labels","description":"Underscores in several labels of a longer name.","config":{"system":{"proxyurl":"squid_1.lan.example.com","proxyport":"3128"}},"ingest":{"proxyUrl":"http://squid_1.lan.example.com:3128"},"php":{"proxy":{"host":"squid_1.lan.example.com","port":"3128","userpwd":null}}},
    {"id":"proxy-host-underscore-at-both-ends","description":"An underscore as the first and last character of the name.","config":{"system":{"proxyurl":"_squid_","proxyport":"3128"}},"ingest":{"proxyUrl":"http://_squid_:3128"},"php":{"proxy":{"host":"_squid_","port":"3128","userpwd":null}}},
    {"id":"proxy-port-service-name-http-alt","description":"A service name that resolves (http-alt is 8080): pfSense's is_port() accepts a service name, and PHP hands CURLOPT_PROXYPORT the string as the number it reads (0): cURL dials its default port, 1080, never the service's (probed on PHP 8.4 with listeners: http-alt, squid, 00 and abc all reached 1080, 3128abc reached 3128).","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"http-alt"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":"http-alt","userpwd":null}}},
    {"id":"proxy-port-service-name-squid","description":"A service name some systems know: pfSense's is_port() accepts a service name, and PHP hands CURLOPT_PROXYPORT the string as the number it reads (0): cURL dials its default port, 1080, never the service's (probed on PHP 8.4 with listeners: http-alt, squid, 00 and abc all reached 1080, 3128abc reached 3128).","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"squid"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":"squid","userpwd":null}}},
    {"id":"proxy-port-00","description":"A port of 00 is not empty() to PHP, yet reads as 0: the default port, 1080 (never port 0).","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"00"}},"ingest":{"proxyUrl":"http://proxy.example.com:1080"},"php":{"proxy":{"host":"proxy.example.com","port":"00","userpwd":null}}},
    {"id":"proxy-port-leading-digits","description":"A port that starts with digits reads as them (3128abc is 3128), as PHP converts it for cURL.","config":{"system":{"proxyurl":"proxy.example.com","proxyport":"3128abc"}},"ingest":{"proxyUrl":"http://proxy.example.com:3128"},"php":{"proxy":{"host":"proxy.example.com","port":"3128abc","userpwd":null}}},
    {"id":"self-none","description":"The box lists no address (the double's default): Core adds only the loopbacks, which are not listed.","config":{},"ingest":{},"php":{"self":{"127.0.0.1":true,"::1":true,"192.168.1.1":false}}},
    {"id":"self-interface-and-vip","description":"Interface addresses, a VIP and the PPPoE server's address, IPv4 then IPv6, as pfSense lists them.","config":{},"platform":{"ipv4":{"lan":"192.168.1.1","wan":"203.0.113.5","_vip1":"192.168.1.2","poes1":"10.10.10.1"},"ipv6":{"lan":"2001:db8:1::1","_vip2":"2001:db8:1::2"}},"ingest":{"selfAddresses":[{"address":"192.168.1.1"},{"address":"203.0.113.5"},{"address":"192.168.1.2"},{"address":"10.10.10.1"},{"address":"2001:db8:1::1"},{"address":"2001:db8:1::2"}]},"php":{"self":{"192.168.1.1":true,"192.168.1.2":true,"10.10.10.1":true,"2001:db8:1::2":true,"192.168.1.99":false,"127.0.0.1":true}}},
    {"id":"self-link-local-excluded","description":"A link-local address the platform lists is not projected, though PHP would call it the box's own.","config":{},"platform":{"ipv4":{"lan":"192.168.1.1","opt1":"169.254.7.7"},"ipv6":{"lan":"fe80::1"}},"ingest":{"selfAddresses":[{"address":"192.168.1.1"}]},"php":{"self":{"192.168.1.1":true,"169.254.7.7":true,"fe80::1":true}}},
    {"id":"self-hostile-addresses","description":"An interface with no address, the unspecified addresses, a mapped IPv4, a word and an address listed twice: only the two real addresses are projected, once each; PHP would call 0.0.0.0 and :: the box's own.","config":{},"platform":{"ipv4":{"a":"0.0.0.0","b":null,"c":"192.168.1.1","d":"192.168.1.1","e":"not-an-ip"},"ipv6":{"a":"::","b":"::ffff:192.168.1.5","c":"2001:db8::1","d":""}},"ingest":{"selfAddresses":[{"address":"192.168.1.1"},{"address":"2001:db8::1"}]},"php":{"self":{"0.0.0.0":true,"::":true,"192.168.1.1":true}}}
