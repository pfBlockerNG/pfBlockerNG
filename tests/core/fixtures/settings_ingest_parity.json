    {"id":"filter-on","description":"pfb_feed_internal_filter on.","config":{"gen":{"pfb_feed_internal_filter":"on"}},"ingest":{},"php":{"filter":true}},
    {"id":"filter-off","description":"pfb_feed_internal_filter empty is an explicit Off.","config":{"gen":{"pfb_feed_internal_filter":""}},"ingest":{"feedHostFilter":false},"php":{"filter":false}},
    {"id":"filter-absent","description":"pfb_feed_internal_filter not stored: the registered default, on.","config":{"gen":{"pfb_feed_internal_allowlist":""}},"ingest":{},"php":{"filter":true}},
    {"id":"filter-legacy-off-token","description":"The legacy token off reads Off.","config":{"gen":{"pfb_feed_internal_filter":"off"}},"ingest":{"feedHostFilter":false},"php":{"filter":false}},
