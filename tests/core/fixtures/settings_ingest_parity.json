    {"id":"allowlist-valid","description":"IPv4 and IPv6 addresses and CIDRs separated by newlines, commas and spaces.","config":{},"allowlistText":"10.0.0.5\n192.168.0.0/16, fd00::/8   2001:db8::1","ingest":{"feedHostAllowlist":[{"cidr":"10.0.0.5"},{"cidr":"192.168.0.0/16"},{"cidr":"fd00::/8"},{"cidr":"2001:db8::1"}]},"php":{"allow":["10.0.0.5","192.168.0.0/16","fd00::/8","2001:db8::1"]}},
    {"id":"allowlist-invalid-dropped","description":"Entries that are no address or subnet (a word, a prefix of 33, three octets, 300) are dropped; the valid ones stay.","config":{},"allowlistText":"10.0.0.5 not-an-ip 10.0.0.0/33 1.2.3 300.1.1.1 10.0.0.0/8","ingest":{"feedHostAllowlist":[{"cidr":"10.0.0.5"},{"cidr":"10.0.0.0/8"}]},"php":{"allow":["10.0.0.5","10.0.0.0/8"]}},
    {"id":"allowlist-base64-garbage","description":"A stored value that is not base64 decodes to junk that holds no valid entry.","config":{"gen":{"pfb_feed_internal_allowlist":"@@@not base64@@@"}},"ingest":{},"php":{"allow":[]}},
    {"id":"allowlist-spaces-and-blank-lines","description":"Spaces, tabs, commas and blank lines only separate entries: no entry holds a space.","config":{},"allowlistText":" 10.0.0.1 ,10.0.0.2,,\t10.0.0.3 \n\n","ingest":{"feedHostAllowlist":[{"cidr":"10.0.0.1"},{"cidr":"10.0.0.2"},{"cidr":"10.0.0.3"}]},"php":{"allow":["10.0.0.1","10.0.0.2","10.0.0.3"]}},
    {"id":"allowlist-ipv6-zone","description":"PHP keeps a link-local address with a zone; Core's list cannot hold a zone, and a resolved address never carries one, so it never matched anyway.","config":{},"allowlistText":"fe80::1%em0 fe80::2","ingest":{"feedHostAllowlist":[{"cidr":"fe80::2"}]},"php":{"allow":["fe80::1%em0","fe80::2"]}},
    {"id":"allowlist-duplicates","description":"An entry repeated is listed once (a list's key is unique); PHP lists it twice.","config":{},"allowlistText":"10.0.0.5 10.0.0.5 10.0.0.0/8 10.0.0.0/8","ingest":{"feedHostAllowlist":[{"cidr":"10.0.0.5"},{"cidr":"10.0.0.0/8"}]},"php":{"allow":["10.0.0.5","10.0.0.5","10.0.0.0/8","10.0.0.0/8"]}},
    {"id":"allowlist-leading-zero-prefix","description":"A prefix length with a leading zero is a subnet to PHP; Core's list cannot hold it (a parser takes 08 for no number), the plain /8 stays.","config":{},"allowlistText":"10.0.0.0/08 10.0.0.0/8","ingest":{"feedHostAllowlist":[{"cidr":"10.0.0.0/8"}]},"php":{"allow":["10.0.0.0/08","10.0.0.0/8"]}},
    {"id":"allowlist-kept-while-the-filter-is-off","description":"The allowlist is read whatever the filter says: the General page keeps it while the filter is off.","config":{"gen":{"pfb_feed_internal_filter":""}},"allowlistText":"10.0.0.5","ingest":{"feedHostFilter":false,"feedHostAllowlist":[{"cidr":"10.0.0.5"}]},"php":{"filter":false,"allow":["10.0.0.5"]}},
