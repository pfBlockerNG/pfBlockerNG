{
	"schema": 1,
	"description": "A redirect to a host with an internal address is refused before it is fetched: asn.csv stays.",
	"hosts": {
		"ipinfo.io": [
			"127.0.0.1",
			"203.0.113.5"
		],
		"internal.example": [
			"127.0.0.1",
			"10.1.2.3"
		]
	},
	"servers": [
		"origin",
		"target"
	],
	"settings": {
		"asn_token": "tok123"
	},
	"seed": {
		"share/asn.csv": "start_ip,end_ip,asn,name,domain\n1.0.0.0,1.0.0.255,AS13335,Cloudflare,cloudflare.com\n"
	},
	"routes": {
		"origin": {
			"/data/free/asn.csv.gz": {
				"status": 302,
				"location": "http://internal.example:{port:target}/hop"
			}
		},
		"target": {
			"/hop": {
				"body": "PWNED\n"
			}
		}
	},
	"steps": [
		{
			"run": "download",
			"extras": [
				{
					"url": "http://ipinfo.io:{port:origin}/data/free/asn.csv.gz?token=",
					"file_dwn": "asn.csv.gz",
					"file": "asn.csv",
					"folder": "share",
					"type": "asn"
				}
			],
			"expect": {
				"ok": false,
				"files": {
					"share/asn.csv": "start_ip,end_ip,asn,name,domain\n1.0.0.0,1.0.0.255,AS13335,Cloudflare,cloudflare.com\n",
					"db/asn.update": null
				},
				"requests": [
					{
						"server": "origin",
						"path": "/data/free/asn.csv.gz",
						"query": "token=tok123"
					}
				],
				"reason": "feed host resolves to a non-permitted address",
				"stage": "fetch"
			}
		}
	]
}
