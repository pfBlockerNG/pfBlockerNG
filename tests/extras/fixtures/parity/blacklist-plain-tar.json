{
	"schema": 1,
	"description": "An uncompressed tar publishes as a gzip does, under the download's name without .tar.",
	"hosts": {
		"bl.example": [
			"127.0.0.1",
			"203.0.113.9"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {},
	"routes": {
		"origin": {
			"/cats.tar": {
				"body_b64": ""
			}
		}
	},
	"steps": [
		{
			"run": "bls",
			"extras": [
				{
					"url": "http://bl.example:{port:origin}/cats.tar",
					"file_dwn": "cats.tar",
					"file": "cats.tar",
					"folder": "db",
					"type": "blacklist",
					"name": "Cats"
				}
			],
			"expect": {
				"ok": true,
				"report": "\tCats ... Completed\n",
				"files": {
					"db/cats/cats_gambling": "bet.example\n",
					"db/cats/cats.update": "",
					"db/cats/lists/gambling/urls": null,
					"db/cats.tar": {
						"b64": ""
					}
				},
				"requests": [
					{
						"server": "origin",
						"path": "/cats.tar"
					}
				]
			}
		}
	]
}
