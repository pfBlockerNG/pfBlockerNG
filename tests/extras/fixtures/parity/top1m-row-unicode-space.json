{
	"schema": 1,
	"description": "Any Unicode white space before a field is skipped, a no-break space included, quoted row or not. str_getcsv() keeps those bytes, so today's PHP refuses both domains (old_expect).",
	"hosts": {
		"tranco-list.eu": [
			"127.0.0.1",
			"203.0.113.11"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {
		"top1m_source": "tranco",
		"top1m_inclusions": "example"
	},
	"seed": {
		"db/top-1m.csv": "1,old.example.com\n"
	},
	"routes": {
		"origin": {
			"/top-1m.csv.zip": {
				"body_b64": "UEsDBBQAAAAIAAAAIVjohU+aKAAAADUAAAAKAAAAdG9wLTFtLmNzdjPUObQgL6m4QC+1IjG3ICeVywgooFRYml+SmgITU+Iy1knPz4fzuQBQSwECFAMUAAAACAAAACFY6IVPmigAAAA1AAAACgAAAAAAAAAAAAAAgAEAAAAAdG9wLTFtLmNzdlBLBQYAAAAAAQABADgAAABQAAAAAAA="
			}
		}
	},
	"steps": [
		{
			"run": "download",
			"extras": [
				{
					"url": "http://tranco-list.eu:{port:origin}/top-1m.csv.zip",
					"file_dwn": "top-1m.csv.zip",
					"file": "top-1m.csv",
					"folder": "db",
					"type": "top1m",
					"provider": "tranco"
				}
			],
			"expect": {
				"ok": true,
				"files": {
					"db/top-1m.csv": {
						"b64": "MSzCoG5ic3AuZXhhbXBsZQoyLMKgInF1b3RlZC5leGFtcGxlIgozLGdvb2QuZXhhbXBsZQo="
					}
				},
				"requests": [
					{
						"server": "origin",
						"path": "/top-1m.csv.zip"
					}
				]
			}
		},
		{
			"run": "whitelist",
			"expect": {
				"ok": true,
				"files": {
					"db/pfbalexawhitelist.txt": "nbsp.example\nquoted.example\ngood.example\n"
				}
			},
			"old_expect": {
				"ok": true,
				"files": {
					"db/pfbalexawhitelist.txt": "good.example\n"
				}
			}
		}
	]
}
