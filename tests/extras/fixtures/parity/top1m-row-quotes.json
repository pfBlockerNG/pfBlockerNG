			"expect": {
				"ok": true,
				"files": {
					"db/top-1m.csv": {
						"b64": "MSwicXVvdGVkLmV4YW1wbGUiCjIsImEiImIuZXhhbXBsZSIKMyx4InkuZXhhbXBsZQo0LCJvcGVuLmV4YW1wbGUKNSxnb29kLmV4YW1wbGUK"
					}
				},
				"requests": [
					{
						"server": "origin",
						"path": "/top-1m.csv.zip"
					}
				]
			}
		},
		{
			"run": "whitelist",
			"expect": {
				"ok": true,
				"files": {
					"db/pfbalexawhitelist.txt": "quoted.example\ngood.example\n"
				}
			}
		}
	]
