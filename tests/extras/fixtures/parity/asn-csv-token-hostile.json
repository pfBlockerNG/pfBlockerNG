{
	"schema": 1,
	"description": "A token with &, #, a space and a line break is encoded into the query, never splitting it.",
	"hosts": {
		"ipinfo.io": [
			"127.0.0.1",
			"203.0.113.5"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {
		"asn_token": "a&b#c d\ne"
	},
	"seed": {
		"share/asn.csv": "start_ip,end_ip,asn,name,domain\n1.0.0.0,1.0.0.255,AS13335,Cloudflare,cloudflare.com\n"
	},
	"routes": {
		"origin": {
			"/data/free/asn.csv.gz": {
				"body_b64": "H4sIAAAAAAAC/ysuSSwqic8s0EnNSwFRicV5OnmJuak6Kfm5iZl5XIZ6BiCoA6GNTE11HIMNjY2NTXWcc/JLU9JyEotSdZLhTL3k/FwuCz0QNNCB0FA9poZmljru+fnpOak66WAKrBYAHZO624AAAAA="
			}
		}
	},
	"steps": [
		{
			"run": "download",
			"extras": [
				{
					"url": "http://ipinfo.io:{port:origin}/data/free/asn.csv.gz?token=",
					"file_dwn": "asn.csv.gz",
					"file": "asn.csv",
					"folder": "share",
					"type": "asn"
				}
			],
			"expect": {
				"ok": true,
				"files": {
					"share/asn.csv": "start_ip,end_ip,asn,name,domain\n1.0.0.0,1.0.0.255,AS13335,Cloudflare,cloudflare.com\n8.8.8.0,8.8.8.255,AS15169,Google,google.com\n",
					"db/script.calls": "asn_table\n"
				},
				"requests": [
					{
						"server": "origin",
						"path": "/data/free/asn.csv.gz",
						"query": "token=a%26b%23c%20d%0Ae"
					}
				]
			}
		}
	]
}
