{
	"schema": 1,
	"description": "A new binary asn.mmdb: what today's MIME gate makes of it.",
	"hosts": {
		"ipinfo.io": [
			"127.0.0.1",
			"203.0.113.5"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {
		"asn_token": "tok123"
	},
	"seed": {
		"share/asn.mmdb": {
			"b64": "AAFPTEQtTU1EQgCrze9NYXhNaW5kLmNvbQAAAAAAAAAA"
		}
	},
	"routes": {
		"origin": {
			"/data/free/asn.mmdb": {
				"body_b64": "AAJORVctTU1EQgCrze9NYXhNaW5kLmNvbQAAAAAAAAAA"
			}
		}
	},
	"steps": [
		{
			"run": "download",
			"extras": [
				{
					"url": "http://ipinfo.io:{port:origin}/data/free/asn.mmdb?token=",
					"file_dwn": "asn.mmdb",
					"file": "asn.mmdb",
					"folder": "share",
					"type": "asn"
				}
			],
			"expect": {
				"ok": true,
				"files": {
					"share/asn.mmdb": {
						"b64": "AAJORVctTU1EQgCrze9NYXhNaW5kLmNvbQAAAAAAAAAA"
					},
					"share/asn.mmdb.raw": null,
					"db/asn.update": ""
				},
				"requests": [
					{
						"server": "origin",
						"path": "/data/free/asn.mmdb",
						"query": "token=tok123"
					}
				]
			}
		}
	]
}
