	"steps": [
		{
			"run": "download",
			"extras": [
				{
					"url": "http://downloads.majestic.com:{port:origin}/majestic_million.csv",
					"file_dwn": "top-1m.csv.zip",
					"file": "top-1m.csv",
					"folder": "db",
					"type": "top1m",
					"provider": "majestic"
				}
			],
			"expect": {
				"ok": false,
				"ledger": "TOP1M download failed",
