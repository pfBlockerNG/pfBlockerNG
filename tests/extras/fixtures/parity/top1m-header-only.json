					"db/top-1m.csv": "1,old.example.com\n",
					"db/top-1m.csv.zip.orig": null,
					"db/top-1m.csv.zip.raw": null,
					"db/top-1m.update": null,
					"db/top-1m.csv.zip.source": null
				},
				"requests": [
					{
						"server": "origin",
						"path": "/majestic_million.csv"
					}
				]
			}
		}
	]
