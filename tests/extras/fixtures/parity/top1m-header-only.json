{
	"schema": 1,
	"description": "Majestic's header without a row is no list: it is refused.",
	"hosts": {
		"downloads.majestic.com": [
			"127.0.0.1",
			"203.0.113.14"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {
		"top1m_source": "majestic"
	},
	"seed": {
		"db/top-1m.csv": "1,old.example.com\n"
	},
	"routes": {
		"origin": {
			"/majestic_million.csv": {
				"body": "GlobalRank,TldRank,Domain,TLD,RefSubNets,RefIPs,IDN_Domain,IDN_TLD,PrevGlobalRank,PrevTldRank,PrevRefSubNets,PrevRefIPs\n"
			}
		}
