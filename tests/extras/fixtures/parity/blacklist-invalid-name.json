{
	"schema": 1,
	"description": "A download name that is not a word refuses the row after the archive is kept, before extraction.",
	"hosts": {
		"bl.example": [
			"127.0.0.1",
			"203.0.113.9"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {},
	"routes": {
		"origin": {
			"/my-list.tar.gz": {
				"body_b64": ""
			}
		}
	},
	"steps": [
		{
			"run": "bls",
			"extras": [
				{
					"url": "http://bl.example:{port:origin}/my-list.tar.gz",
					"file_dwn": "my-list.tar.gz",
					"file": "my-list.tar.gz",
					"folder": "db",
					"type": "blacklist",
					"name": "Mine"
				}
			],
			"expect": {
				"ok": false,
				"report": "\tMine ... Failed\n",
				"files": {
					"db/my-list.tar.gz": {
						"b64": ""
					},
					"db/my-list": null,
					"db/my_list": null
				},
				"requests": [
					{
						"server": "origin",
						"path": "/my-list.tar.gz"
					}
				]
			}
		}
	]
}
