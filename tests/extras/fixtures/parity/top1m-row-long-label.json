{
	"schema": 1,
	"description": "A label over 63 bytes is kept, as today's PHP keeps it; the list is published whole.",
	"hosts": {
		"tranco-list.eu": [
			"127.0.0.1",
			"203.0.113.11"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {
		"top1m_source": "tranco",
		"top1m_inclusions": "com,de,example"
