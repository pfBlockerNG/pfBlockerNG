{
	"schema": 1,
	"description": "A folder an interrupted swap left aside is put back first, then replaced by the new publication.",
	"hosts": {
		"bl.example": [
			"127.0.0.1",
			"203.0.113.9"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {},
	"seed": {
		"db/.pfbstagebak2_ut1/ut1_old": "gone.example\n"
	},
	"routes": {
		"origin": {
			"/ut1.tar.gz": {
				"body_b64": ""
			}
		}
	},
	"steps": [
		{
			"run": "bls",
			"extras": [
				{
					"url": "http://bl.example:{port:origin}/ut1.tar.gz",
					"file_dwn": "ut1.tar.gz",
					"file": "ut1.tar.gz",
					"folder": "db",
					"type": "blacklist",
					"name": "UT1"
				}
			],
			"expect": {
				"ok": true,
				"report": "\tUT1 ... Completed\n",
				"files": {
					"db/ut1/ut1_adult": "adult.example\n",
					"db/ut1/ut1_old": null,
					"db/.pfbstagebak2_ut1/ut1_old": null
				},
				"requests": [
					{
						"server": "origin",
						"path": "/ut1.tar.gz"
					}
				]
			}
		}
	]
}
