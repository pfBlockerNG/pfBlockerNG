{
	"schema": 1,
	"description": "A category archive replaces the whole category folder: every domains member under its renamed category, a dash made an underscore, the archive kept and its sidecars dropped.",
	"hosts": {
		"bl.example": [
			"127.0.0.1",
			"203.0.113.9"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {},
	"seed": {
		"db/ut1/ut1_adult": "old.example\n",
		"db/ut1/ut1_old": "gone.example\n",
		"db/ut1.tar.gz": "old archive\n"
	},
	"routes": {
		"origin": {
			"/ut1.tar.gz": {
				"body_b64": ""
			}
		}
	},
	"steps": [
		{
			"run": "bls",
			"extras": [
				{
					"url": "http://bl.example:{port:origin}/ut1.tar.gz",
					"file_dwn": "ut1.tar.gz",
					"file": "ut1.tar.gz",
					"folder": "db",
					"type": "blacklist",
					"name": "UT1"
				}
			],
			"seed": {
				"db/ut1.tar.gz.orig": "o\n",
				"db/ut1.tar.gz.md5": "m\n",
				"db/ut1.tar.gz.xxhash128": "x\n"
			},
			"expect": {
				"ok": true,
				"report": "\tUT1 ... Completed\n",
				"files": {
					"db/ut1/ut1_adult": "adult.example\n",
					"db/ut1/ut1_ads_sub": "sub.example\n",
					"db/ut1/ut1_a_b": "ab.example\n",
					"db/ut1/ut1_a-b": null,
					"db/ut1/ut1_y_z": "z.example\n",
					"db/ut1/ut1.update": "",
					"db/ut1/blacklists/adult/baddomains": "bad.example\n",
					"db/ut1/blacklists/adult/urls": null,
					"db/ut1/blacklists/README": null,
					"db/ut1/ut1_old": null,
					"db/ut1.tar.gz": {
						"b64": ""
					},
					"db/ut1.tar.gz.raw": null,
					"db/ut1.tar.gz.orig": null,
					"db/ut1.tar.gz.md5": null,
					"db/ut1.tar.gz.xxhash128": null
				},
				"requests": [
					{
						"server": "origin",
						"path": "/ut1.tar.gz"
					}
				]
			}
		}
	]
}
