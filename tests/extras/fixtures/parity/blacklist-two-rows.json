{
	"schema": 1,
	"description": "Each row reports on its own line; one failed row fails the run without stopping the next.",
	"hosts": {
		"bl.example": [
			"127.0.0.1",
			"203.0.113.9"
		]
	},
	"servers": [
		"origin"
	],
	"settings": {},
	"seed": {
		"db/ut1/ut1_adult": "old.example\n",
		"db/ut1/ut1_old": "gone.example\n",
		"db/ut1.tar.gz": "old archive\n"
	},
	"routes": {
		"origin": {
			"/ut1.tar.gz": {
				"status": 500,
				"body": "error\n"
			},
			"/cats.tar": {
				"body_b64": ""
			}
		}
	},
	"steps": [
		{
			"run": "bls",
			"extras": [
				{
					"url": "http://bl.example:{port:origin}/ut1.tar.gz",
					"file_dwn": "ut1.tar.gz",
					"file": "ut1.tar.gz",
					"folder": "db",
					"type": "blacklist",
					"name": "UT1"
				},
				{
					"url": "http://bl.example:{port:origin}/cats.tar",
					"file_dwn": "cats.tar",
					"file": "cats.tar",
					"folder": "db",
					"type": "blacklist",
					"name": "Cats"
				}
			],
			"expect": {
				"ok": false,
				"report": "\tUT1 ... Failed\n\tCats ... Completed\n",
				"files": {
					"db/ut1/ut1_adult": "old.example\n",
					"db/ut1/ut1_old": "gone.example\n",
					"db/ut1/ut1.update": null,
					"db/ut1.tar.gz.raw": null,
					"db/cats/cats_gambling": "bet.example\n"
				},
				"requests": [
					{
						"server": "origin",
						"path": "/ut1.tar.gz"
					},
					{
						"server": "origin",
						"path": "/cats.tar"
					}
				],
				"reason": "500 Internal Server Error",
				"stage": "transfer"
			}
		}
	]
}
