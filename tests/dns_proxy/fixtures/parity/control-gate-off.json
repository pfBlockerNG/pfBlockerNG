{
  "schema": 2,
  "description": "python_control_legacy on but python_control not set (off by default): the legacy branch is entered but obeys no command",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "python_control_legacy": "true",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {"version": 1, "config": {}, "feeds": []},
    "files": {}
  },
  "upstream": {
    "python_control.nosuchcommand. TXT": ["python_control.nosuchcommand. 300 IN TXT \"from-upstream\""]
  },
  "cases": [
    {
      "id": "loopback-client-is-relayed-when-python-control-is-off",
      "family": "control",
      "description": "with python_control off, a loopback client's python_control TXT query is an ordinary query for Unbound, not a command",
      "query": {"name": "python_control.nosuchcommand.", "type": "TXT", "client": "127.0.0.1"},
      "expect": {
        "decision": "relay",
        "forwards": ["python_control.nosuchcommand. TXT"],
        "rcode": "NOERROR",
        "answer": ["python_control.nosuchcommand. 300 IN TXT \"from-upstream\""],
        "authority": []
      }
    }
  ]
}
