{
  "schema": 4,
  "description": "a whitelisted alias of a blocked target, queried before the target itself is: the alias's CNAME-context allow is the chain's verdict, not the target's own, so a direct query for the target afterwards is still blocked (issue #3775)",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {"user_whitelist": ["trusted.example"]},
      "feeds": [{"raw": "pfb_py_raw/vip.txt", "feed": "VipFeed", "group": "VipGroup", "log_flag": "1"}]
    },
    "files": {
      "pfb_py_raw/vip.txt": ["trusted-target.example"]
    }
  },
  "upstream": {
    "trusted.example. A": ["trusted.example. 300 IN CNAME trusted-target.example.", "trusted-target.example. 300 IN A 192.0.2.97"]
  },
  "cases": [
    {
      "id": "whitelisted-alias-queried-first-is-relayed",
      "family": "cname",
      "description": "the alias is on the user whitelist, so its blocked CNAME target does not block it (issue #3222); this is the target's first evaluation, done in the alias's CNAME context",
      "query": {"name": "trusted.example.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["trusted.example. A"],
        "rcode": "NOERROR",
        "answer": ["trusted.example. 300 IN CNAME trusted-target.example.", "trusted-target.example. 300 IN A 192.0.2.97"],
        "authority": []
      }
    },
    {
      "id": "target-queried-directly-after-the-alias-is-still-blocked",
      "family": "cname",
      "description": "the target queried on its own after the alias is answered with the VIP address: the alias's allow did not become the target's own verdict (issue #3775)",
      "query": {"name": "trusted-target.example.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["trusted-target.example. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    }
  ]
}
