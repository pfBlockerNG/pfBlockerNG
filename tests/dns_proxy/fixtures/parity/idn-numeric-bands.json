{
  "schema": 1,
  "description": "IDN mode All with a feed @@ exception loaded (important_rules on, so the numeric band resolution decides): the IDN block carries the feed block band, so an xn-- name is still blocked",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "idn_mode": "on",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {"builtin_log_flag": "1"},
      "feeds": [{"raw": "pfb_py_raw/feed.txt", "feed": "Feed", "group": "Group", "log_flag": "1"}]
    },
    "files": {
      "pfb_py_raw/feed.txt": ["||x.example^", "@@||y.example^"]
    }
  },
  "upstream": {
    "plain.example. A": ["plain.example. 300 IN A 192.0.2.10"]
  },
  "cases": [
    {
      "id": "idn-name-is-still-blocked",
      "family": "idn",
      "description": "with the numeric band resolution active, an xn-- name is blocked as a VIP answer (the IDN block is not overridden by an allow band of 0)",
      "query": {"name": "xn--mnchen-3ya.com.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["xn--mnchen-3ya.com. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "plain-name-relays",
      "family": "idn",
      "description": "the control: a name that is not an IDN still resolves with the numeric band resolution active",
      "query": {"name": "plain.example.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["plain.example. A"],
        "rcode": "NOERROR",
        "answer": ["plain.example. 300 IN A 192.0.2.10"],
        "authority": []
      }
    }
  ]
}
