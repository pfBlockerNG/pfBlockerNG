        "rcode": "NOERROR",
        "answer": [],
        "authority": ["blocked.example. 3600 IN SOA pfb.invalid. nobody.invalid. 1 3600 1200 604800 3600"]
      }
    },
    {
      "id": "blocked-svcb-answers-nodata-with-the-soa",
      "family": "qtype",
      "description": "a blocked name asked for SVCB has no address to give: NOERROR, no answer, the SOA",
      "query": {"name": "blocked.example.", "type": "SVCB"},
