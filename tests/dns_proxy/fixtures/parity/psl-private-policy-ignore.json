{
  "schema": 4,
  "description": "a feed line at the PRIVATE suffix pages.com under psl_feed_private_policy = ignore (Wildcard Blocking on, PRIVATE suffixes not recognised); the ICANN policy stays honor",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "python_tld_wildcard": "true",
        "psl_include_private": "false",
        "psl_feed_private_policy": "ignore",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {},
      "feeds": [{"raw": "pfb_py_raw/feed.txt", "feed": "Feed", "group": "Group", "log_flag": "1"}]
    },
    "files": {
      "dnsbl_psl": [
        "// ===BEGIN ICANN DOMAINS===",
        "com",
        "example",
        "uk",
        "co.uk",
        "org.uk",
        "ac.uk",
        "gov.uk",
        "*.ck",
        "!www.ck",
        "// ===END ICANN DOMAINS===",
        "// ===BEGIN PRIVATE DOMAINS===",
        "pages.com",
        "// ===END PRIVATE DOMAINS==="
      ],
      "pfb_py_raw/feed.txt": ["pages.com", "org.uk"]
    }
  },
  "upstream": {
    "pages.com. A": ["pages.com. 300 IN A 192.0.2.10"],
    "x.pages.com. A": ["x.pages.com. 300 IN A 192.0.2.11"]
  },
  "cases": [
    {
      "id": "private-suffix-line-is-dropped",
      "family": "psl",
      "description": "the line at the private suffix is dropped: pages.com resolves",
      "query": {"name": "pages.com.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["pages.com. A"],
        "rcode": "NOERROR",
        "answer": ["pages.com. 300 IN A 192.0.2.10"],
        "authority": []
      }
    },
    {
      "id": "dropped-private-suffix-line-covers-nothing",
      "family": "psl",
      "description": "and so does a name under it",
      "query": {"name": "x.pages.com.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["x.pages.com. A"],
        "rcode": "NOERROR",
        "answer": ["x.pages.com. 300 IN A 192.0.2.11"],
        "authority": []
      }
    },
    {
      "id": "icann-policy-is-independent-of-the-private-one",
      "family": "psl",
      "description": "the plain line at the ICANN suffix org.uk is an exact entry",
      "query": {"name": "org.uk.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["org.uk. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    }
  ]
}
