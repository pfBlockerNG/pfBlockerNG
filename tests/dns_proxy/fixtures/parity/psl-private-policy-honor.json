{
  "schema": 1,
  "description": "a feed line at the PRIVATE suffix pages.com under psl_feed_private_policy = honor (Wildcard Blocking on, PRIVATE suffixes not recognised); the ICANN policy stays honor",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "python_tld_wildcard": "true",
        "psl_include_private": "false",
        "psl_feed_private_policy": "honor",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {},
      "feeds": [{"raw": "pfb_py_raw/feed.txt", "feed": "Feed", "group": "Group", "log_flag": "1"}]
    },
    "files": {
      "dnsbl_psl": [
        "// ===BEGIN ICANN DOMAINS===",
        "com",
        "example",
        "uk",
        "co.uk",
        "org.uk",
        "ac.uk",
        "gov.uk",
        "*.ck",
        "!www.ck",
        "// ===END ICANN DOMAINS===",
        "// ===BEGIN PRIVATE DOMAINS===",
        "pages.com",
        "// ===END PRIVATE DOMAINS==="
      ],
      "pfb_py_raw/feed.txt": ["pages.com", "org.uk"]
    }
  },
  "upstream": {},
  "cases": [
    {
      "id": "private-suffix-line-blankets-the-suffix",
      "family": "psl",
      "description": "honoured, the classifier makes pages.com a zone: a name under it is blocked",
      "query": {"name": "x.pages.com.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["x.pages.com. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "private-suffix-line-blocks-the-suffix",
      "family": "psl",
      "description": "and the suffix itself",
      "query": {"name": "pages.com.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["pages.com. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "icann-policy-is-independent-of-the-private-one",
      "family": "psl",
      "description": "the plain line at the ICANN suffix org.uk is an exact entry",
      "query": {"name": "org.uk.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["org.uk. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    }
  ]
}
