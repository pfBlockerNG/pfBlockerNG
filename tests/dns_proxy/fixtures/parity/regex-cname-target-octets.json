    },
    {
      "id": "leading-dot-star-needs-its-literal-after-a-newline-octet",
      "family": "regex",
      "description": "R13: the control: a CNAME target with the same newline octet but without the rule's literal bad.example resolves",
      "query": {"name": "alias-nlx.example.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["alias-nlx.example. A"],
        "rcode": "NOERROR",
        "answer": ["alias-nlx.example. 300 IN CNAME nl\\010ok.example.", "nl\\010ok.example. 300 IN A 192.0.2.22"],
        "authority": []
      }
    }
  ]
