{
  "schema": 1,
  "description": "psl_feed_icann_policy = ignore loads the public-suffix list and psl_feed_private_policy stays honor: a PRIVATE suffix entry is kept as listed while an ICANN suffix entry is dropped (Wildcard Blocking off)",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "python_tld_wildcard": "false",
        "psl_feed_private_policy": "honor",
        "psl_feed_icann_policy": "ignore",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {},
      "feeds": [{"raw": "pfb_py_raw/feed.txt", "feed": "Feed", "group": "Group", "log_flag": "1"}]
    },
    "files": {
      "dnsbl_psl": [
        "// ===BEGIN ICANN DOMAINS===",
        "com",
        "example",
        "uk",
        "co.uk",
        "org.uk",
        "ac.uk",
        "gov.uk",
        "*.ck",
        "!www.ck",
        "// ===END ICANN DOMAINS===",
        "// ===BEGIN PRIVATE DOMAINS===",
        "pages.com",
        "// ===END PRIVATE DOMAINS==="
      ],
      "pfb_py_raw/feed.txt": ["||pages.com^", "org.uk"]
    }
  },
  "upstream": {
    "org.uk. A": ["org.uk. 300 IN A 192.0.2.10"]
  },
  "cases": [
    {
      "id": "icann-plain-line-at-a-suffix-is-dropped",
      "family": "psl",
      "description": "the ICANN policy is active: a plain line at the ICANN suffix org.uk is dropped and the name resolves",
      "query": {"name": "org.uk.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["org.uk. A"],
        "rcode": "NOERROR",
        "answer": ["org.uk. 300 IN A 192.0.2.10"],
        "authority": []
      }
    },
    {
      "id": "private-abp-zone-at-a-suffix-is-kept",
      "family": "psl",
      "description": "the private policy is honor while another policy is active: ||pages.com^ stays a zone and blocks pages.com",
      "query": {"name": "pages.com.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["pages.com. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "private-abp-zone-at-a-suffix-still-covers-its-tenants",
      "family": "psl",
      "description": "and the kept zone still blocks a tenant of the private suffix",
      "query": {"name": "x.pages.com.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["x.pages.com. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    }
  ]
}
