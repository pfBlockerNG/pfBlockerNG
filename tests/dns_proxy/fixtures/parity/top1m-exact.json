{
  "schema": 4,
  "description": "TOP1M on, Wildcard Blocking off: a TOP1M-marked Group drops its exact entries for names TOP1M lists (popular.example, big.example), an unmarked Group does not",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "python_tld_wildcard": "false",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {"top1m_enabled": true},
      "feeds": [
        {"raw": "pfb_py_raw/marked.txt", "feed": "MarkedFeed", "group": "MarkedGroup", "log_flag": "1", "top1m": true},
        {"raw": "pfb_py_raw/plain.txt", "feed": "PlainFeed", "group": "PlainGroup", "log_flag": "1"}
      ]
    },
    "files": {
      "pfb_py_top1m.txt": ["popular.example", "big.example"],
      "pfb_py_raw/marked.txt": ["popular.example", "www.big.example", "deep.popular.example", "tracker.example"],
      "pfb_py_raw/plain.txt": ["big.example"]
    }
  },
  "upstream": {
    "popular.example. A": ["popular.example. 300 IN A 192.0.2.10"],
    "www.big.example. A": ["www.big.example. 300 IN A 192.0.2.11"]
  },
  "cases": [
    {
      "id": "marked-group-entry-for-a-listed-name-relays",
      "family": "top1m",
      "description": "a marked Group's exact entry for a name TOP1M lists is dropped: the name resolves",
      "query": {"name": "popular.example.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["popular.example. A"],
        "rcode": "NOERROR",
        "answer": ["popular.example. 300 IN A 192.0.2.10"],
        "authority": []
      }
    },
    {
      "id": "unmarked-group-entry-for-a-listed-name-blocks",
      "family": "top1m",
      "description": "the same kind of entry on an unmarked Group still blocks the listed name big.example",
      "query": {"name": "big.example.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["big.example. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "marked-group-entry-for-the-www-form-of-a-listed-name-relays",
      "family": "top1m",
      "description": "a marked Group's entry for www. plus a listed name is dropped too",
      "query": {"name": "www.big.example.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["www.big.example. A"],
        "rcode": "NOERROR",
        "answer": ["www.big.example. 300 IN A 192.0.2.11"],
        "authority": []
      }
    },
    {
      "id": "marked-group-entry-for-a-subdomain-of-a-listed-name-blocks",
      "family": "top1m",
      "description": "a deeper subdomain of a listed name is not listed, so the entry stands",
      "query": {"name": "deep.popular.example.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["deep.popular.example. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "marked-group-entry-for-an-unlisted-name-blocks",
      "family": "top1m",
      "description": "a marked Group still blocks a name TOP1M does not list",
      "query": {"name": "tracker.example.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["tracker.example. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    }
  ]
}
