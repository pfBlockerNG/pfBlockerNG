{
  "schema": 3,
  "description": "IDN mode off with the DNSBL otherwise running: xn-- names resolve",
  "module": {
    "ini": {
      "MAIN": {
        "python_enable": "true",
        "python_blocking": "true",
        "python_cname": "true",
        "idn_mode": "off",
        "dnsbl_ipv4": "10.10.10.1",
        "dnsbl_ipv6": "fd00::1"
      }
    },
    "manifest": {
      "version": 1,
      "config": {"builtin_log_flag": "1"},
      "feeds": [{"raw": "pfb_py_raw/feed.txt", "feed": "Feed", "group": "Group", "log_flag": "1"}]
    },
    "files": {"pfb_py_raw/feed.txt": ["listed.example"]}
  },
  "upstream": {
    "xn--mnchen-3ya.com. A": ["xn--mnchen-3ya.com. 300 IN A 192.0.2.10"]
  },
  "cases": [
    {
      "id": "listed-name-is-still-blocked",
      "family": "idn",
      "description": "the DNSBL is running: a listed name is blocked",
      "query": {"name": "listed.example.", "type": "A"},
      "expect": {
        "decision": "answer",
        "forwards": [],
        "rcode": "NOERROR",
        "answer": ["listed.example. 3600 IN A 10.10.10.1"],
        "authority": []
      }
    },
    {
      "id": "idn-name-relays",
      "family": "idn",
      "description": "an xn-- name resolves when IDN mode is off",
      "query": {"name": "xn--mnchen-3ya.com.", "type": "A"},
      "expect": {
        "decision": "relay",
        "forwards": ["xn--mnchen-3ya.com. A"],
        "rcode": "NOERROR",
        "answer": ["xn--mnchen-3ya.com. 300 IN A 192.0.2.10"],
        "authority": []
      }
    }
  ]
}
