{
 "description": "The runhooks verb's post context without a trigger argument: the trigger manual-test, both change flags 0, PFB_STATUS ok and both change lists empty, as the one-shot's stdin object says it. Only enabled post rows run, in list order. Without a lifecycle nothing is copied to the console.",
 "caller": "runhooks",
 "argv": [
  "post"
 ],
 "when": "post",
 "stdin": "{\"trigger\":\"manual-test\",\"ipChanged\":false,\"dnsblChanged\":false,\"changedIpAliases\":\"\",\"changedDnsblGroups\":\"\"}",
 "rows": [
  {
   "script": "hook_post_a.sh",
   "when": "post",
   "enabled": "on",
   "description": "First"
  },
  {
   "script": "hook_pre_x.sh",
   "when": "pre",
   "enabled": "on"
  },
  {
   "script": "hook_post_b.sh",
   "when": "post",
   "enabled": "on"
  }
 ],
 "files": {
  "hooks/hook_post_a.sh": {
   "body": "#!/bin/sh\n{record}\necho 'a says hi'\n"
  },
  "hooks/hook_pre_x.sh": {
   "body": "#!/bin/sh\n{record}\n"
  },
  "hooks/hook_post_b.sh": {
   "body": "#!/bin/sh\n{record}\n"
  }
 },
 "expect": {
  "runs": [
   {
    "script": "hook_post_a.sh",
    "wrapped": false,
    "args": [],
    "env": {
     "PFB_WHEN": "post",
     "PFB_TRIGGER": "manual-test",
     "PFB_POST_INSTALL": "0",
     "PFB_PRE_UNINSTALL": "0",
     "PFB_PKG_OP": "",
     "PFB_IP_CHANGED": "0",
     "PFB_DNSBL_CHANGED": "0",
     "PFB_STATUS": "ok",
     "PFB_CHANGED_IP_ALIASES": "",
     "PFB_CHANGED_DNSBL_GROUPS": ""
    }
   },
   {
    "script": "hook_post_b.sh",
    "wrapped": false,
    "args": [],
    "env": {
     "PFB_WHEN": "post",
     "PFB_TRIGGER": "manual-test",
     "PFB_POST_INSTALL": "0",
     "PFB_PRE_UNINSTALL": "0",
     "PFB_PKG_OP": "",
     "PFB_IP_CHANGED": "0",
     "PFB_DNSBL_CHANGED": "0",
     "PFB_STATUS": "ok",
     "PFB_CHANGED_IP_ALIASES": "",
     "PFB_CHANGED_DNSBL_GROUPS": ""
    }
   }
  ],
  "log": "\n[ pfB Hook ] post First (hook_post_a.sh, timeout 60s)\na says hi\n[ pfB Hook ] post First completed\n\n[ pfB Hook ] post #1 (hook_post_b.sh, timeout 60s)\n[ pfB Hook ] post #1 completed\n",
  "console": ""
 }
}
