			function drawRegionsMap() {
				var data = google.visualization.arrayToDataTable([
					['Country', 'Attacks'],
['MX', 2],['AU', 2],['NL', 3],['BG', 7],['JP', 12],['FI', 1],['CH', 1],['GB', 21],['US', 149],['HK', 8],['SE', 3],['CN', 35],['GR', 2],['IL', 2],['ID', 5],['EU', 2],['RU', 7],['DE', 7],['SG', 3],['UA', 1],['BE', 1],['FR', 8],['NZ', 1],['IN', 1],['IE', 1],['CA', 9],['ES', 2],['PK', 1],['AR', 1],['TR', 1],['IR', 2],['IT', 1],['JO', 1],['RO', 1],['KW', 1],['LB', 1],['KR', 1],['HU', 1],['DK', 1],				]);

