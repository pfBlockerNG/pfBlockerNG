<?xml version="1.0" encoding="UTF-8"?>
<!-- Red canary for scripts/check-skip-allowlist.py (issue #2359, testing.md's red-canary
     rule): one skipped testcase whose id can never legitimately appear on
     tests/skip-allowlist.txt. classname/name are suite neutral, so the resulting
     id (SUITE:SkipAllowlistCanary::test_this_id_is_never_on_any_allowlist) is
     valid input regardless of which suite value the CI step passes. -->
<testsuites>
  <testsuite name="skip-allowlist-canary" tests="1" failures="0" skipped="1">
    <testcase classname="SkipAllowlistCanary" name="test_this_id_is_never_on_any_allowlist" time="0">
      <skipped message="canary: this skip must never appear on tests/skip-allowlist.txt"/>
    </testcase>
  </testsuite>
</testsuites>
