<?xml version="1.0" encoding="UTF-8"?>
<!-- One skipped testcase whose id can never legitimately appear on
     tests/skip-allowlist.txt, so feeding this report to the checker must fail.
     classname/name are suite neutral, so the id is valid input whichever suite value
     the CI step passes, and both skip element shapes appear because shellspec writes <skip>
     where pytest and PHPUnit write <skipped>. -->
<testsuites>
  <testsuite name="skip-allowlist-canary" tests="2" failures="0" skipped="2">
    <testcase classname="SkipAllowlistCanary" name="test_this_id_is_never_on_any_allowlist" time="0">
      <skipped message="canary: this skip must never appear on tests/skip-allowlist.txt"/>
    </testcase>
    <testcase classname="SkipAllowlistCanary" name="test_this_shellspec_shaped_id_is_never_on_any_allowlist" time="0">
      <skip message="canary: shellspec writes this element name instead" />
    </testcase>
  </testsuite>
</testsuites>
