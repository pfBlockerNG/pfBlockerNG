{
 "schema": 1,
 "description": "A ;type=i suffix is the binary transfer already in use: it is not part of the file name.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  {
   "name": "ftp",
   "kind": "ftp"
  }
 ],
 "files": {
  "ftp": {
   "/b.txt": {
    "body": "bee\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "ftp://feed.example:{port:ftp}/b.txt;type=i",
   "expect": {
    "ok": true,
    "published": "bee\n",
    "digest": "b552309e634cd2800cf266d7184d641c",
    "requests": [
     {
      "server": "ftp",
      "command": "USER anonymous"
     },
     {
      "server": "ftp",
      "command": "PASS ftp@example.com"
     },
     {
      "server": "ftp",
      "command": "MDTM b.txt"
     },
     {
      "server": "ftp",
      "command": "EPSV"
     },
     {
      "server": "ftp",
      "command": "TYPE I"
     },
     {
      "server": "ftp",
      "command": "SIZE b.txt"
     },
     {
      "server": "ftp",
      "command": "RETR b.txt"
     },
     {
      "server": "ftp",
      "data_to": "127.0.0.1"
     }
    ]
   }
  }
 ]
}
