{
 "schema": 1,
 "description": "A self-hosted body over the ceiling is refused.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/feed.txt": {
    "body": "0123456789abcdef0123456789abcde\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://127.0.0.1:{port:origin}/feed.txt",
   "ceiling": 16,
   "expect": {
    "ok": false,
    "published": null,
    "reason": "local_too_large",
    "requests": [
     {
      "server": "origin",
      "path": "/feed.txt"
     }
    ]
   }
  }
 ]
}
