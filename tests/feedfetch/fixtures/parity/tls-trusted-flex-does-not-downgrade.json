{
 "schema": 1,
 "description": "With Flex on and a trusted certificate the first, verified attempt succeeds: one connection, no downgrade.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  {
   "name": "secure",
   "tls": true,
   "cert": "trusted"
  }
 ],
 "routes": {
  "secure": {
   "/list": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "https://feed.example:{port:secure}/list",
   "flex": true,
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "secure",
      "tls": "connect"
     },
     {
      "server": "secure",
      "path": "/list"
     }
    ]
   }
  }
 ]
}
