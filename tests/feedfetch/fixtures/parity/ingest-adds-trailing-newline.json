{
 "schema": 1,
 "description": "The published copy gains a trailing newline when the body lacks one.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/list": {
    "body": "a\nb"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "a\nb\n",
    "requests": [
     {
      "server": "origin",
      "path": "/list"
     }
    ]
   }
  }
 ]
}
