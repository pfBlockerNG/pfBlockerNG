{
 "schema": 1,
 "description": "An ingest that publishes a probe body takes that response's validators as a set (#3911): a Last-Modified the response did not carry is dropped, and a later changed probe's validators replace the earlier probe's.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "seed": {
  "published": "old\n",
  "etag": "\"v0\"",
  "lastmod": 1600000000
 },
 "routes": {
  "origin": {
   "/list": {
    "body": "new\n",
    "etag": "\"v1\""
   }
  }
 },
 "steps": [
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "old\n",
    "decision": "changed",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v0\""
     }
    ],
    "etag": "\"v0\"",
    "lastmod": 1600000000
   }
  },
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "new\n",
    "digest": "07baf267a0c0ef53ec95a82711cc4758",
    "requests": [],
    "etag": "\"v1\"",
    "lastmod": null
   }
  },
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "routes": {
    "origin": {
     "/list": {
      "body": "two\n",
      "etag": "\"v2\"",
      "last_modified": 1700000000
     }
    }
   },
   "expect": {
    "ok": true,
    "published": "new\n",
    "decision": "changed",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v1\""
     }
    ],
    "etag": "\"v1\"",
    "lastmod": null
   }
  },
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "routes": {
    "origin": {
     "/list": {
      "body": "three\n",
      "last_modified": 1750000000
     }
    }
   },
   "expect": {
    "ok": true,
    "published": "new\n",
    "decision": "changed",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v1\""
     }
    ],
    "etag": "\"v1\"",
    "lastmod": null
   }
  },
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "three\n",
    "digest": "0826ab323b13ef19594776f0dced5574",
    "requests": [],
    "etag": null,
    "lastmod": 1750000000
   }
  }
 ]
}
