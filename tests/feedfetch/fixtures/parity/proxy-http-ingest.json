{
 "schema": 1,
 "description": "An http feed goes through the system proxy in absolute form; the origin sees the feed's own Host.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "proxy": {
  "server": "proxy"
 },
 "routes": {
  "origin": {
   "/list": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "proxy",
      "method": "GET",
      "target": "http://feed.example:{port:origin}/list"
     },
     {
      "server": "origin",
      "path": "/list",
      "host": "feed.example:{port:origin}"
     }
    ]
   }
  }
 ]
}
