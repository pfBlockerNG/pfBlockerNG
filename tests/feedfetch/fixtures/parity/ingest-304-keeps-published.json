{
 "schema": 1,
 "description": "An unconditional 304 on ingest keeps the published copy and its validators.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "seed": {
  "published": "old\n",
  "etag": "\"v0\"",
  "lastmod": 1700000000
 },
 "routes": {
  "origin": {
   "/list": {
    "status": 304
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "old\n",
    "requests": [
     {
      "server": "origin",
      "path": "/list"
     }
    ],
    "etag": "\"v0\"",
    "lastmod": 1700000000
   }
  }
 ]
}
