{
 "schema": 1,
 "description": "With the filter on the host is vetted and pinned, but through a proxy the pinned address is never dialled: the proxy is asked for the name.",
 "hosts": {
  "feed.example": [
   "127.0.0.2"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "allowlist": [
  "127.0.0.2"
 ],
 "servers": [
  "origin"
 ],
 "proxy": {
  "server": "proxy"
 },
 "routes": {
  "origin": {
   "/list": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "proxy",
      "method": "GET",
      "target": "http://feed.example:{port:origin}/list"
     },
     {
      "server": "origin",
      "path": "/list"
     }
    ]
   }
  }
 ]
}
