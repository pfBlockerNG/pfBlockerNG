{
 "schema": 1,
 "description": "With the feed-host filter off a redirect to an internal host is followed.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ],
  "localhost": [
   "10.1.2.3"
  ]
 },
 "filter": false,
 "servers": [
  "origin",
  "target"
 ],
 "routes": {
  "origin": {
   "/rdr": {
    "status": 302,
    "location": "http://localhost:{port:target}/hop"
   }
  },
  "target": {
   "/hop": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://localhost:{port:origin}/rdr",
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "requests": [
     {
      "server": "origin",
      "path": "/rdr"
     },
     {
      "server": "target",
      "path": "/hop"
     }
    ]
   }
  }
 ]
}
