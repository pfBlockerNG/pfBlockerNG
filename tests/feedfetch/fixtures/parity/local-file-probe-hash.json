{
 "schema": 1,
 "description": "A local feed is unchanged while its bytes hash like the last ingest and changed once they differ.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "local_files": {
  "src.txt": "1.2.3.4"
 },
 "steps": [
  {
   "op": "ingest",
   "url": "{local}/src.txt",
   "expect": {
    "ok": true,
    "published": "1.2.3.4\n",
    "digest": "58e4591c78f52321c1f46a00b34477f9",
    "requests": []
   }
  },
  {
   "op": "probe",
   "url": "{local}/src.txt",
   "expect": {
    "ok": true,
    "published": "1.2.3.4\n",
    "decision": "unchanged",
    "requests": []
   }
  },
  {
   "op": "probe",
   "url": "{local}/src.txt",
   "local_files": {
    "src.txt": "5.6.7.8\n"
   },
   "expect": {
    "ok": true,
    "published": "1.2.3.4\n",
    "decision": "changed",
    "requests": []
   }
  }
 ]
}
