{
 "schema": 1,
 "description": "With the filter on and a proxy, a redirect to an internal host is refused before the proxy is asked about it: the feed fails and the published copy is kept.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ],
  "internal.example": [
   "127.0.0.1",
   "10.1.2.3"
  ]
 },
 "servers": [
  "origin",
  "target"
 ],
 "proxy": {
  "server": "proxy"
 },
 "seed": {
  "published": "old\n",
  "etag": "\"v0\"",
  "lastmod": 1700000000
 },
 "routes": {
  "origin": {
   "/evil": {
    "status": 302,
    "location": "http://internal.example:{port:target}/hop"
   }
  },
  "target": {
   "/hop": {
    "body": "PWNED\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/evil",
   "expect": {
    "ok": false,
    "published": "old\n",
    "reason": "feed host resolves to a non-permitted address",
    "etag": null,
    "lastmod": null,
    "requests": [
     {
      "server": "proxy",
      "method": "GET",
      "target": "http://feed.example:{port:origin}/evil"
     },
     {
      "server": "origin",
      "path": "/evil"
     }
    ]
   }
  }
 ]
}
