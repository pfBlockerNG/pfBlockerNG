{
 "schema": 1,
 "description": "On one port that serves https and http, an https feed redirecting to http on the same host and port changes the scheme alone: Basic credentials and an Authorization header stop at the https hop (#1919, #1953).",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  {
   "name": "dual",
   "tls": true,
   "cert": "trusted",
   "plain_too": true
  }
 ],
 "routes": {
  "dual": {
   "/basic": {
    "status": 302,
    "location": "http://feed.example:{port:dual}/land"
   },
   "/bearer": {
    "status": 302,
    "location": "http://feed.example:{port:dual}/land"
   },
   "/land": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "https://feed.example:{port:dual}/basic",
   "username": "user",
   "password": "secret",
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "dual",
      "tls": "connect"
     },
     {
      "server": "dual",
      "path": "/basic",
      "authorization": "Basic dXNlcjpzZWNyZXQ="
     },
     {
      "server": "dual",
      "path": "/land"
     }
    ]
   }
  },
  {
   "op": "ingest",
   "url": "https://feed.example:{port:dual}/bearer",
   "headers": [
    "Authorization: Bearer tok"
   ],
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "dual",
      "tls": "connect"
     },
     {
      "server": "dual",
      "path": "/bearer",
      "authorization": "Bearer tok"
     },
     {
      "server": "dual",
      "path": "/land"
     }
    ]
   }
  }
 ]
}
