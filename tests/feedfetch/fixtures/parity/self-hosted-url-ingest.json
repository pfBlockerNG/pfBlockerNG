{
 "schema": 1,
 "description": "A URL on the box itself at the web root is read without the remote path.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/feed.txt": {
    "body": "s\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://127.0.0.1:{port:origin}/feed.txt",
   "expect": {
    "ok": true,
    "published": "s\n",
    "digest": "679456626cb751b879217737b277bdcb",
    "requests": [
     {
      "server": "origin",
      "path": "/feed.txt"
     }
    ]
   }
  }
 ]
}
