{
 "schema": 1,
 "description": "With the feed-host filter off an internal host is fetched by name, without vetting or pinning.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ],
  "localhost": [
   "10.1.2.3"
  ]
 },
 "filter": false,
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/list": {
    "body": "a\nb\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://localhost:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "a\nb\n",
    "requests": [
     {
      "server": "origin",
      "path": "/list"
     }
    ]
   }
  }
 ]
}
