{
 "schema": 1,
 "description": "The probe sends the stored ETag; a 304 means unchanged and nothing is fetched or published.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "seed": {
  "published": "old\n",
  "etag": "\"v1\""
 },
 "routes": {
  "origin": {
   "/list": {
    "body": "new\n",
    "etag": "\"v1\""
   }
  }
 },
 "steps": [
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "old\n",
    "decision": "unchanged",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v1\""
     }
    ],
    "etag": "\"v1\"",
    "lastmod": null
   }
  }
 ]
}
