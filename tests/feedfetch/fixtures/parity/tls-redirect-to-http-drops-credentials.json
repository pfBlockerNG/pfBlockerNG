{
 "schema": 1,
 "description": "An https feed redirecting to http on the same host name (another port) is another origin: Basic credentials and an Authorization header stop at the https hop (#1919, #1953).",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  {
   "name": "secure",
   "tls": true,
   "cert": "trusted"
  },
  "plain"
 ],
 "routes": {
  "secure": {
   "/basic": {
    "status": 302,
    "location": "http://feed.example:{port:plain}/land"
   },
   "/bearer": {
    "status": 302,
    "location": "http://feed.example:{port:plain}/land"
   }
  },
  "plain": {
   "/land": {
    "body": "BODY\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "https://feed.example:{port:secure}/basic",
   "username": "user",
   "password": "secret",
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "secure",
      "tls": "connect"
     },
     {
      "server": "secure",
      "path": "/basic",
      "authorization": "Basic dXNlcjpzZWNyZXQ="
     },
     {
      "server": "plain",
      "path": "/land"
     }
    ]
   }
  },
  {
   "op": "ingest",
   "url": "https://feed.example:{port:secure}/bearer",
   "headers": [
    "Authorization: Bearer tok"
   ],
   "expect": {
    "ok": true,
    "published": "BODY\n",
    "digest": "f688192737a93ab01f03c9345b0ab795",
    "requests": [
     {
      "server": "secure",
      "tls": "connect"
     },
     {
      "server": "secure",
      "path": "/bearer",
      "authorization": "Bearer tok"
     },
     {
      "server": "plain",
      "path": "/land"
     }
    ]
   }
  }
 ]
}
