{
 "schema": 1,
 "description": "Dot segments, %2e spellings included, are removed before the path is split; an encoded slash is not a segment boundary, so a decoded .. is sent as CWD ..",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  {
   "name": "ftp",
   "kind": "ftp"
  }
 ],
 "files": {
  "ftp": {
   "/b.txt": {
    "body": "bee\n"
   },
   "/dir/x.txt": {
    "body": "x\n"
   },
   "/a/b.txt": {
    "body": "ab\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "ftp://feed.example:{port:ftp}/dir/../b.txt",
   "expect": {
    "ok": true,
    "published": "bee\n",
    "digest": "b552309e634cd2800cf266d7184d641c",
    "requests": [
     {
      "server": "ftp",
      "command": "USER anonymous"
     },
     {
      "server": "ftp",
      "command": "PASS ftp@example.com"
     },
     {
      "server": "ftp",
      "command": "MDTM b.txt"
     },
     {
      "server": "ftp",
      "command": "EPSV"
     },
     {
      "server": "ftp",
      "command": "TYPE I"
     },
     {
      "server": "ftp",
      "command": "SIZE b.txt"
     },
     {
      "server": "ftp",
      "command": "RETR b.txt"
     },
     {
      "server": "ftp",
      "data_to": "127.0.0.1"
     }
    ]
   }
  },
  {
   "op": "ingest",
   "url": "ftp://feed.example:{port:ftp}/dir/%2e%2e/b.txt",
   "expect": {
    "ok": true,
    "published": "bee\n",
    "digest": "b552309e634cd2800cf266d7184d641c",
    "requests": [
     {
      "server": "ftp",
      "command": "USER anonymous"
     },
     {
      "server": "ftp",
      "command": "PASS ftp@example.com"
     },
     {
      "server": "ftp",
      "command": "MDTM b.txt"
     },
     {
      "server": "ftp",
      "command": "EPSV"
     },
     {
      "server": "ftp",
      "command": "TYPE I"
     },
     {
      "server": "ftp",
      "command": "SIZE b.txt"
     },
     {
      "server": "ftp",
      "command": "RETR b.txt"
     },
     {
      "server": "ftp",
      "data_to": "127.0.0.1"
     }
    ]
   }
  },
  {
   "op": "ingest",
   "url": "ftp://feed.example:{port:ftp}/dir/.%2e/b.txt",
   "expect": {
    "ok": true,
    "published": "bee\n",
    "digest": "b552309e634cd2800cf266d7184d641c",
    "requests": [
     {
      "server": "ftp",
