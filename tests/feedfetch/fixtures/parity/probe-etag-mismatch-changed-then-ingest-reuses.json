{
 "schema": 1,
 "description": "A 200 to the conditional probe is a change; the new ETag is stored, the ingest reuses the probe body, and the next probe gets a 304.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "seed": {
  "published": "old\n",
  "etag": "\"v0\""
 },
 "routes": {
  "origin": {
   "/list": {
    "body": "new\n",
    "etag": "\"v1\""
   }
  }
 },
 "steps": [
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "old\n",
    "decision": "changed",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v0\""
     }
    ],
    "etag": "\"v1\"",
    "lastmod": null
   }
  },
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "new\n",
    "requests": [],
    "etag": "\"v1\"",
    "lastmod": null
   }
  },
  {
   "op": "probe",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "new\n",
    "decision": "unchanged",
    "requests": [
     {
      "server": "origin",
      "path": "/list",
      "if_none_match": "\"v1\""
     }
    ],
    "etag": "\"v1\"",
    "lastmod": null
   }
  }
 ]
}
