{
 "schema": 1,
 "description": "Row 1: a plain text body is published as served, the digest is of the wire bytes.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ]
 },
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/list": {
    "body": "1.2.3.4\n5.6.7.8\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/list",
   "expect": {
    "ok": true,
    "published": "1.2.3.4\n5.6.7.8\n",
    "digest": "3a37adf6991862f9608d33aceb0fbd96",
    "requests": [
     {
      "server": "origin",
      "path": "/list"
     }
    ]
   }
  }
 ]
}
