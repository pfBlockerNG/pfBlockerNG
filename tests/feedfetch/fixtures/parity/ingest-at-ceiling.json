{
 "schema": 1,
 "description": "A body exactly at the ceiling is accepted.",
 "hosts": {
  "feed.example": [
   "127.0.0.1",
   "203.0.113.5"
  ],
  "rdr.example": [
   "127.0.0.1",
   "203.0.113.6"
  ]
 },
 "servers": [
  "origin"
 ],
 "routes": {
  "origin": {
   "/edge": {
    "body": "0123456789abcde\n"
   }
  }
 },
 "steps": [
  {
   "op": "ingest",
   "url": "http://feed.example:{port:origin}/edge",
   "ceiling": 16,
   "expect": {
    "ok": true,
    "published": "0123456789abcde\n",
    "requests": [
     {
      "server": "origin",
      "path": "/edge"
     }
    ]
   }
  }
 ]
}
