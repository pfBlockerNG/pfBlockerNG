#!/bin/sh
# Linux stand-in for the one pgrep form the pinned r272 core runs: `pgrep -qnF PIDFILE` (isvalidpid(), util.inc). procps-ng 4.0.4
# takes -F but rejects -q (exit 2), so that call answered "not running" for every pid. This form drops -q and asks procps the same
# question; every other form is procps' own (pgrep.procps, the real binary, which the Dockerfile moves aside).
REAL=/usr/local/libexec/pgrep.procps
if [ "$1" = -qnF ] && [ $# -eq 2 ]; then
	exec "$REAL" -nF "$2" >/dev/null
fi
exec "$REAL" "$@"
