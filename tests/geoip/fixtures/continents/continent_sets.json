      "cc": {"ZA_v4.txt": "41.0.0.0/11", "NG_v4.txt": "102.0.0.0/8\n"},
      "expect": {
        "files": {"original/pfB_Africa_v4.orig": "41.0.0.0/11102.0.0.0/8\n", "deny/pfB_Africa_v4.txt": "41.0.0.0/11102.0.0.0/8\n"},
        "changed": ["pfB_Africa_v4"],
        "log": []
      }
    },
