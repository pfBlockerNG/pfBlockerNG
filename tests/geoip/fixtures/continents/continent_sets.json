    {
      "id": "an-unterminated-set-equal-to-its-baseline-is-unchanged",
      "description": "A set is compared with its baseline as it would be stored, its last line terminated: an unterminated country list equal to the baseline is no change.",
      "groups": [{"name": "pfB_Africa", "action": "Deny_Inbound", "listClass": "deny", "countriesV4": ["ZA"], "countriesV6": []}],
      "cc": {"ZA_v4.txt": "41.0.0.0/11"},
      "before": {"original/pfB_Africa_v4.orig": "41.0.0.0/11\n", "deny/pfB_Africa_v4.txt": "41.0.0.0/11\n"},
      "expect": {
        "files": {"original/pfB_Africa_v4.orig": "41.0.0.0/11\n", "deny/pfB_Africa_v4.txt": "41.0.0.0/11\n"},
        "changed": [],
        "log": []
      },
      "old_expect": {
        "files": {"original/pfB_Africa_v4.orig": "41.0.0.0/11\n", "deny/pfB_Africa_v4.txt": "41.0.0.0/11\n"},
        "changed": ["pfB_Africa_v4"],
        "log": []
      },
      "departure": "Today's PHP compares the md5 of the set before its newline is added with the stored baseline, so an unterminated set is a change at every pass; Core compares the set as it stores it."
    },
    {
      "id": "unterminated-lists-run-together",
      "description": "Country lists are concatenated byte for byte, as today: a list without a final newline runs into the next one's first line.",
