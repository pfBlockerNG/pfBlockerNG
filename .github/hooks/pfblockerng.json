{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "sh \"$(git rev-parse --show-toplevel)/scripts/agent/copilot-session-hook.sh\" start",
        "timeoutSec": 120
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "sh \"$(git rev-parse --show-toplevel)/scripts/agent/copilot-session-hook.sh\" end",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "sh \"$(git rev-parse --show-toplevel)/scripts/agent/copilot-session-hook.sh\" subagent",
        "timeoutSec": 10
      }
    ]
  }
}
