{
  "servers": {
    "intelephense": {
      "command": "intelephense",
      "args": ["--stdio"],
      "fileTypes": [".php", ".phtml", ".inc"],
      "languageId": "php",
      "rootMarkers": ["composer.json", "composer.lock", ".git"],
      "settings": {
        "intelephense": {
          "environment": { "phpVersion": "8.3" },
          "files": { "associations": ["*.php", "*.phtml", "*.inc"] }
        }
      }
    }
  }
}
